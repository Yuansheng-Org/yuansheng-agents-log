diff --git a/faiss/impl/scalar_quantizer/sq-rvv.cpp b/faiss/impl/scalar_quantizer/sq-rvv.cpp
index 2b86e5c79e9cc9a05c44e34ccfc77729d270a777..9625d5f7f5c4ebbeea7a4698e7ff1e20bd51ab0f 100644
--- a/faiss/impl/scalar_quantizer/sq-rvv.cpp
