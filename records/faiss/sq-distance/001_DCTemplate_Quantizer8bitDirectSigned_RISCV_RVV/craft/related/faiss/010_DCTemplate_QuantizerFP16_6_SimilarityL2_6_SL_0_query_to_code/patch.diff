@@ -125,11 +127,100 @@ struct SimilarityIP<SIMDLevel::RISCV_RVV> : SimilarityIP<SIMDLevel::NONE> {
  * falls through to scalar code. Callers and the dispatcher don't know or care.
  ************************************************************************/
 
+namespace detail_rvv {
+
+/// Squared-L2 between q and r: persistent vector accumulator, single final
+/// reduction. Avoids the per-iteration scalar round-trip that serializes the
+/// loop (each iteration would otherwise extract the partial sum to a scalar
+/// register and re-inject it via vsetivli 1 + vfmv.s.f).
+inline float distance_l2_rvv(const float* q, const float* r, size_t d) {
+    size_t vlmax = __riscv_vsetvlmax_e32m8();
+    vfloat32m8_t acc = __riscv_vfmv_v_f_f32m8(0.0f, vlmax);
+    size_t i = 0;
+    while (i < d) {
+        size_t vl = __riscv_vsetvl_e32m8(d - i);
+        vfloat32m8_t vq = __riscv_vle32_v_f32m8(q + i, vl);
+        vfloat32m8_t vr = __riscv_vle32_v_f32m8(r + i, vl);
+        vfloat32m8_t diff = __riscv_vfsub_vv_f32m8(vq, vr, vl);
+        acc = __riscv_vfmacc_vv_f32m8_tu(acc, diff, diff, vl);
+        i += vl;
+    }
+    return rvv_reduce(acc, vlmax, 0.0f, __riscv_vfredusum_vs_f32m8_f32m1);
+}
+
+/// Inner product between q and r (same accumulator discipline as L2).
+inline float distance_ip_rvv(const float* q, const float* r, size_t d) {
+    size_t vlmax = __riscv_vsetvlmax_e32m8();
+    vfloat32m8_t acc = __riscv_vfmv_v_f_f32m8(0.0f, vlmax);
+    size_t i = 0;
+    while (i < d) {
+        size_t vl = __riscv_vsetvl_e32m8(d - i);
+        vfloat32m8_t vq = __riscv_vle32_v_f32m8(q + i, vl);
+        vfloat32m8_t vr = __riscv_vle32_v_f32m8(r + i, vl);
+        acc = __riscv_vfmacc_vv_f32m8_tu(acc, vq, vr, vl);
+        i += vl;
+    }
+    return rvv_reduce(acc, vlmax, 0.0f, __riscv_vfredusum_vs_f32m8_f32m1);
+}
+
+template <class Sim>
+struct is_l2_similarity
+        : std::is_same<Sim, SimilarityL2<SIMDLevel::RISCV_RVV>> {};
+
+} // namespace detail_rvv
+
+/// Generic RVV distance computer. Decodes the packed code once into a scratch
+/// float buffer (reusing the exact scalar decode semantics), then runs the
+/// distance loop fully vectorized with LMUL=8 and a single reduction. This
+/// replaces the previous tag-only fallback that inherited the scalar NONE
+/// DCTemplate for every non-4bit-uniform codec.
 template <class Quantizer, class Similarity>
 struct DCTemplate<Quantizer, Similarity, SIMDLevel::RISCV_RVV>
-        : DCTemplate<Quantizer, Similarity, SIMDLevel::NONE> {
-    using Base = DCTemplate<Quantizer, Similarity, SIMDLevel::NONE>;
-    using Base::Base;
+        : SQDistanceComputer {
+    using Sim = Similarity;
+
+    Quantizer quant;
+    mutable std::vector<float> tmp;
+    mutable std::vector<float> tmp2;
+
+    DCTemplate(size_t d, const std::vector<float>& trained)
+            : quant(d, trained), tmp(d), tmp2(d) {}
+
+    float compute_distance(const float* x, const uint8_t* code) const {
+        quant.decode_vector(code, tmp.data());
+        if constexpr (detail_rvv::is_l2_similarity<Sim>::value) {
+            return detail_rvv::distance_l2_rvv(x, tmp.data(), quant.d);
+        } else {
+            return detail_rvv::distance_ip_rvv(x, tmp.data(), quant.d);
+        }
+    }
+
+    float compute_code_distance(
+            const uint8_t* code1,
+            const uint8_t* code2) const {
+        quant.decode_vector(code1, tmp.data());
+        quant.decode_vector(code2, tmp2.data());
+        if constexpr (detail_rvv::is_l2_similarity<Sim>::value) {
+            return detail_rvv::distance_l2_rvv(
+                    tmp.data(), tmp2.data(), quant.d);
+        } else {
+            return detail_rvv::distance_ip_rvv(
+                    tmp.data(), tmp2.data(), quant.d);
+        }
+    }
+
+    void set_query(const float* x) final {
+        q = x;
+    }
+
+    float symmetric_dis(idx_t i, idx_t j) override {
+        return compute_code_distance(
+                codes + i * code_size, codes + j * code_size);
+    }
+
+    float query_to_code(const uint8_t* code) const final {
+        return compute_distance(q, code);
+    }
 };
 
