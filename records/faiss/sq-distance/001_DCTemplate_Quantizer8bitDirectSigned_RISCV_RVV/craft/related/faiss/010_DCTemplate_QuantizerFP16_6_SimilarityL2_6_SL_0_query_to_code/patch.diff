+template <>
+void compute_PQ_dis_tables_dsub2<SIMDLevel::RISCV_RVV>(
+        size_t d,
+        size_t ksub,
+        const float* all_centroids,
+        size_t nx,
+        const float* x,
+        bool is_inner_product,
+        float* dis_tables) {
+    size_t M = d / 2;
+    // Fixed 8-lane work: each centroids[k] holds 2 dims for up to 4 m's
+    // (m0..m0+3). vsetvl_e32m1(8) returns min(8, vlmax), so it stays correct
+    // on VLEN<256 too instead of silently dropping tail lanes.
+    size_t vl = __riscv_vsetvl_e32m1(8);
+    for (size_t m0 = 0; m0 < M; m0 += 4) {
+        size_t m1 = std::min(M, m0 + 4);
+        size_t ndim = 2 * (m1 - m0);
+        for (size_t k0 = 0; k0 < ksub; k0 += 8) {
+            vfloat32m1_t centroids[8];
+            for (size_t k = 0; k < 8; k++) {
+                float centroid[8] = {0, 0, 0, 0, 0, 0, 0, 0};
+                size_t rp = (m0 * ksub + k + k0) * 2;
+                for (size_t m = m0; m < m1; m++) {
+                    size_t w = 2 * (m - m0);
+                    centroid[w] = all_centroids[rp];
+                    centroid[w + 1] = all_centroids[rp + 1];
+                    rp += 2 * ksub;
+                }
+                centroids[k] = __riscv_vle32_v_f32m1(centroid, vl);
+            }
+            for (size_t i = 0; i < nx; i++) {
+                float xtmp[8] = {0, 0, 0, 0, 0, 0, 0, 0};
+                const float* xp = x + i * d + m0 * 2;
+                for (size_t j = 0; j < ndim; j++) {
+                    xtmp[j] = xp[j];
+                }
+                vfloat32m1_t xi = __riscv_vle32_v_f32m1(xtmp, vl);
+                float* out = dis_tables + (i * M + m0) * ksub + k0;
+                if (is_inner_product) {
+                    for (size_t k = 0; k < 8; k++) {
+                        vfloat32m1_t p =
+                                __riscv_vfmul_vv_f32m1(xi, centroids[k], vl);
+                        out[k] = rvv_reduce(
+                                p, vl, 0.0f,
+                                __riscv_vfredusum_vs_f32m1_f32m1);
+                    }
+                } else {
+                    for (size_t k = 0; k < 8; k++) {
+                        vfloat32m1_t diff =
+                                __riscv_vfsub_vv_f32m1(xi, centroids[k], vl);
+                        vfloat32m1_t sq =
+                                __riscv_vfmul_vv_f32m1(diff, diff, vl);
+                        out[k] = rvv_reduce(
+                                sq, vl, 0.0f,
+                                __riscv_vfredusum_vs_f32m1_f32m1);
+                    }
+                }
+            }
+        }
+    }
+}
+
+template <>
+void fvec_add<SIMDLevel::RISCV_RVV>(
+        size_t d,
+        const float* a,
+        const float* b,
+        float* c) {
+    size_t i = 0;
+    while (i < d) {
+        size_t vl = __riscv_vsetvl_e32m8(d - i);
+        vfloat32m8_t va = __riscv_vle32_v_f32m8(a + i, vl);
+        vfloat32m8_t vb = __riscv_vle32_v_f32m8(b + i, vl);
+        vfloat32m8_t vc = __riscv_vfadd_vv_f32m8(va, vb, vl);
+        __riscv_vse32_v_f32m8(c + i, vc, vl);
+        i += vl;
+    }
+}
+
