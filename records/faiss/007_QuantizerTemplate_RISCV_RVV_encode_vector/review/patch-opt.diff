+// Bit-exact vector form of the scalar codecs' `(int)(x * 15.0)` /
+// `(int)(x * 63.0)` component quantization. Those literals are doubles, so
+// the scalar reference multiplies in double precision and truncates; the
+// product x * nmax is exact for a float x (24-bit significand times a <=6
+// bit constant fits in 30 bits), so it is evaluated exactly in the integer
+// domain: x = m * 2^(e - 150) with m = 2^23 + mantissa for normalized x,
+// hence floor(nmax * x) = (nmax * m) >> (150 - e). Only NaN survives the
+// caller's clamping (comparisons against NaN are false); RISC-V scalar
+// fcvt of NaN yields 0x7fffffff, so the scalar code stores nmax for NaN
+// lanes, which the final merge reproduces.
+FAISS_ALWAYS_INLINE vuint32m8_t
+quantize_component_exact(vfloat32m8_t xi, uint32_t nmax, size_t vl) {
+    vuint32m8_t bits = __riscv_vreinterpret_v_f32m8_u32m8(xi);
+    bits = __riscv_vand_vx_u32m8(bits, 0x7fffffff, vl);
+    vbool4_t is_nan = __riscv_vmsgtu_vx_u32m8_b4(bits, 0x7f800000, vl);
+    vuint32m8_t e = __riscv_vsrl_vx_u32m8(bits, 23, vl);
+    // strip the exponent before OR-ing the implicit bit: the product must
+    // be nmax * (2^23 + mantissa), not nmax * the raw float word
+    vuint32m8_t m = __riscv_vor_vx_u32m8(
+            __riscv_vand_vx_u32m8(bits, 0x7fffff, vl), 0x800000, vl);
+    vuint32m8_t a = __riscv_vmul_vx_u32m8(m, nmax, vl);
+    // inputs are in [0, 1] (or NaN), so e <= 127 and the true shift is >= 23;
+    // clamping to 31 only zeroes lanes whose exact product is below 1
+    vuint32m8_t shift =
+            __riscv_vminu_vx_u32m8(__riscv_vrsub_vx_u32m8(e, 150, vl), 31, vl);
+    vuint32m8_t q = __riscv_vsrl_vv_u32m8(a, shift, vl);
+    return __riscv_vmerge_vxm_u32m8(q, nmax, is_nan, vl);
+}
+
+// Narrow u32m8 lanes to bytes in two steps: RVV narrowing operations
+// halve SEW, so u32 -> u8 is a chain of two vnsrl (with an optional
+// pre-shift to select the byte).
+FAISS_ALWAYS_INLINE vuint8m2_t
+narrow_to_u8(vuint32m8_t v, uint32_t shift, size_t vl) {
+    vuint16m4_t w = __riscv_vnsrl_wx_u16m4(v, shift, vl);
+    return __riscv_vnsrl_wx_u8m2(w, 0, vl);
+}
