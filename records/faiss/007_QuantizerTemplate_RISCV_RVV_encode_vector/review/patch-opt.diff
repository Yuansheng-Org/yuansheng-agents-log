+                xi = __riscv_vmerge_vvm_f32m8(
+                        xi, __riscv_vfmv_v_f_f32m8(0.0f, vl), m_lo, vl);
+                vbool4_t m_hi = __riscv_vmfgt_vf_f32m8_b4(xi, 1.0f, vl);
+                xi = __riscv_vmerge_vvm_f32m8(
+                        xi, __riscv_vfmv_v_f_f32m8(1.0f, vl), m_hi, vl);
+            } else {
+                xi = __riscv_vfmv_v_f_f32m8(0.0f, vl);
+            }
+            Codec::encode_m8_components(xi, code, i, vl);
+            i += vl;
+        }
+        // pack-misaligned tail (< ALIGN components): scalar reference path
+        for (; i < d; i++) {
+            float xi = 0;
+            if (this->vdiff != 0) {
+                xi = (x[i] - this->vmin) / this->vdiff;
+                if (xi < 0) {
+                    xi = 0;
+                }
+                if (xi > 1.0) {
+                    xi = 1.0;
+                }
+            }
+            Codec::encode_component(xi, code, i);
+        }
+    }
