+
+// Parity between a SIMD level and the scalar (NONE) path for the encode
+// direction of one quantizer type and dimension. The RVV encode kernels
+// are bit-exact by construction, so every code byte must match exactly.
+// Extreme inputs (out-of-range, denormals, NaN, the fp16 65504 overflow
+// boundary) exercise the clamps and the float->integer conversion edges.
+void check_sq_encode_path_parity(
+        faiss::SIMDLevel level,
+        faiss::ScalarQuantizer::QuantizerType qtype,
+        size_t d) {
+    ScopedSIMDLevel scoped(level);
+    const size_t n = 64;
+    std::vector<float> xb = make_normalized_vectors(n, d);
+
+    std::vector<float> xq(d);
+    const std::vector<float> extremes = {
+            0.0f,
+            -0.0f,
+            1.0f,
+            -1.0f,
+            0.5f,
+            1e-44f,
+            -1e-44f,
+            65504.0f,
+            65519.0f,
+            1e30f,
+            -1e30f,
+            254.5f,
+            255.5f,
+            -0.5f,
+            NAN,
+            INFINITY,
+            -INFINITY};
+    for (size_t j = 0; j < d; j++) {
+        xq[j] = extremes[j % extremes.size()];
+    }
+
+    faiss::ScalarQuantizer sq(d, qtype);
+    sq.train(n, xb.data());
+
+    std::unique_ptr<faiss::ScalarQuantizer::SQuantizer> scalar_quant(
+            faiss::scalar_quantizer::sq_select_quantizer<
+                    faiss::SIMDLevel::NONE>(qtype, d, sq.trained));
+    std::unique_ptr<faiss::ScalarQuantizer::SQuantizer> simd_quant(
+            sq.select_quantizer());
+    ASSERT_NE(scalar_quant, nullptr);
+    ASSERT_NE(simd_quant, nullptr);
+
+    // encode_vector packs with |= into a zeroed buffer (compute_codes
+    // memsets before encoding); mirror that for both paths.
+    std::vector<uint8_t> ref(sq.code_size), out(sq.code_size);
+    for (size_t v = 0; v < n; v++) {
+        SCOPED_TRACE(testing::Message() << "vector " << v);
+        std::fill(ref.begin(), ref.end(), 0);
+        std::fill(out.begin(), out.end(), 0);
+        scalar_quant->encode_vector(xb.data() + v * d, ref.data());
+        simd_quant->encode_vector(xb.data() + v * d, out.data());
+        for (size_t b = 0; b < sq.code_size; b++) {
+            EXPECT_EQ(ref[b], out[b]) << "byte " << b;
+        }
+    }
+
+    SCOPED_TRACE("extremes");
+    std::fill(ref.begin(), ref.end(), 0);
+    std::fill(out.begin(), out.end(), 0);
+    scalar_quant->encode_vector(xq.data(), ref.data());
+    simd_quant->encode_vector(xq.data(), out.data());
+    for (size_t b = 0; b < sq.code_size; b++) {
+        EXPECT_EQ(ref[b], out[b]) << "byte " << b;
+    }
+}
+
+// RVV-versus-scalar parity for the encode direction of every quantizer
+// with RVV kernels, over dimensions around VLMAX boundaries (see
+// RVVDistancePathParity for the chunk-boundary rationale). The code bytes
+// must match the scalar reference exactly, including for the NaN /
+// out-of-range / denormal inputs injected by check_sq_encode_path_parity.
+TEST(ScalarQuantizer, RVVEncodePathParity) {
+    if (!faiss::SIMDConfig::is_simd_level_available(
+                faiss::SIMDLevel::RISCV_RVV)) {
+        GTEST_SKIP() << "RISCV_RVV not available on this machine";
+    }
+
+    const std::vector<faiss::ScalarQuantizer::QuantizerType> qtypes = {
+            faiss::ScalarQuantizer::QT_8bit,
+            faiss::ScalarQuantizer::QT_4bit,
+            // QT_6bit is absent: its RVV decode measured slower than
+            // scalar (see RVVDistancePathParity), so the 6-bit codec is a
+            // scalar marker under RISCV_RVV and both its encode and decode
+            // dispatch to the scalar implementation.
+            faiss::ScalarQuantizer::QT_8bit_uniform,
+            faiss::ScalarQuantizer::QT_4bit_uniform,
+    };
+    const std::vector<size_t> dims = {
+            1,
+            7,
+            31,
+            32,
+            33,
+            63,
+            64,
+            65,
+            127,
+            128,
+            129,
+            255,
+            256,
+            257,
+            511,
+            512,
+            513};
+
+    for (auto qtype : qtypes) {
+        for (size_t d : dims) {
+            SCOPED_TRACE(
+                    testing::Message()
+                    << "qtype=" << static_cast<int>(qtype) << " d=" << d);
+            check_sq_encode_path_parity(faiss::SIMDLevel::RISCV_RVV, qtype, d);
+        }
+    }
+}
