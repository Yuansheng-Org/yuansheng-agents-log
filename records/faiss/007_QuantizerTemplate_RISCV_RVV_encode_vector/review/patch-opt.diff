+    // encode_vector for the public ScalarQuantizer::compute_codes() /
+    // sa_encode() API. The normalization mirrors the scalar reference
+    // exactly: the clamps are masked merges rather than vfmin/vfmax (those
+    // would resolve NaN lanes to a number; the scalar branches leave NaN
+    // untouched), and NaN flows into the codec, where both paths turn it
+    // into the fcvt all-ones code.
+    void encode_vector(const float* x, uint8_t* code) const final {
+        constexpr size_t ALIGN = Codec::encode_alignment;
+        size_t i = 0;
+        const size_t d = this->d;
+        while (i < d) {
+            size_t vl = __riscv_vsetvl_e32m8(d - i);
+            // keep chunks pack-aligned: VLMAX is a power of two >= 8, so
+            // only the final short chunk gets trimmed
+            vl -= vl % ALIGN;
+            if (vl == 0) {
+                break;
+            }
+            vfloat32m8_t xi = __riscv_vle32_v_f32m8(x + i, vl);
+            if (this->vdiff != 0) {
+                xi = __riscv_vfdiv_vf_f32m8(
+                        __riscv_vfsub_vf_f32m8(xi, this->vmin, vl),
+                        this->vdiff,
+                        vl);
