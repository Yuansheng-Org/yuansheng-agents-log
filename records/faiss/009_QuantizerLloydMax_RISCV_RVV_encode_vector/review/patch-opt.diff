+// OR-accumulate the k-th lane beyond base_idx of q, shifted left by
+// k * bits — the packing primitive for the sub-byte LloydMax codecs.
+FAISS_ALWAYS_INLINE vuint32m8_t gather_shl_or(
+        vuint32m8_t acc,
+        vuint32m8_t q,
+        vuint32m8_t base_idx,
+        uint32_t k,
+        uint32_t bits,
+        size_t vl) {
+    vuint32m8_t g = __riscv_vrgather_vv_u32m8(
+            q, __riscv_vadd_vx_u32m8(base_idx, k, vl), vl);
+    return __riscv_vor_vv_u32m8(
+            acc, __riscv_vsll_vx_u32m8(g, k * bits, vl), vl);
+}
