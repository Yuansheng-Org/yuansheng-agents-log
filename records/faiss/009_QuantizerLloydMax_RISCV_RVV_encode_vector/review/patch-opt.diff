+    // encode_vector for the public ScalarQuantizer::compute_codes() /
+    // sa_encode() API: per-component binary search over the boundaries
+    // (select_index_m8) followed by the 1-bit-per-component packing.
+    // Chunks stay multiples of 8 components so every packed byte is owned
+    // by exactly one chunk (the buffer is zeroed by the callers).
+    void encode_vector(const float* x, uint8_t* code) const final {
+        constexpr size_t ALIGN = 8;
+        size_t i = 0;
+        while (i < this->d) {
+            size_t vl = __riscv_vsetvl_e32m8(this->d - i);
+            vl -= vl % ALIGN;
+            if (vl == 0) {
+                break;
+            }
+            vuint32m8_t q = select_index_m8<1>(
+                    this->boundaries, __riscv_vle32_v_f32m8(x + i, vl), vl);
+            const size_t byte_vl = vl >> 3;
+            vuint32m8_t idx = __riscv_vsll_vx_u32m8(
+                    __riscv_vid_v_u32m8(byte_vl), 3, byte_vl);
+            vuint32m8_t w = __riscv_vrgather_vv_u32m8(q, idx, byte_vl);
+            w = gather_shl_or(w, q, idx, 1, 1, byte_vl);
+            w = gather_shl_or(w, q, idx, 2, 1, byte_vl);
+            w = gather_shl_or(w, q, idx, 3, 1, byte_vl);
+            w = gather_shl_or(w, q, idx, 4, 1, byte_vl);
+            w = gather_shl_or(w, q, idx, 5, 1, byte_vl);
+            w = gather_shl_or(w, q, idx, 6, 1, byte_vl);
+            w = gather_shl_or(w, q, idx, 7, 1, byte_vl);
+            __riscv_vse8_v_u8m2(
+                    code + (i >> 3), narrow_to_u8(w, 0, byte_vl), byte_vl);
+            i += vl;
+        }
+        // sub-byte misaligned tail: scalar reference path
+        for (; i < this->d; i++) {
+            this->encode_index(this->select_index(x[i]), code, i);
+        }
+    }
 };
 
