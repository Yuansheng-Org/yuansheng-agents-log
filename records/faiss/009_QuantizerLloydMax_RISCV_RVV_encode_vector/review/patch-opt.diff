+// Vectorized upper_bound over the LloydMax boundaries: per lane, the
+// number of boundaries <= x, which is exactly the scalar select_index
+// (std::upper_bound). Per-lane bisection over [0, kCentroidsCount): each
+// round gathers boundaries[mid] with an indexed load, compares, and moves
+// lo/hi; converged lanes clamp their gather index to K-2 and are masked
+// out of the updates. NaN queries shrink to 0 on both paths (every
+// boundaries[mid] <= NaN comparison is false).
+template <int NBits>
+FAISS_ALWAYS_INLINE vuint32m8_t
+select_index_m8(const float* boundaries, vfloat32m8_t x, size_t vl) {
+    constexpr size_t K = size_t(1) << NBits;
+    vuint32m8_t lo = __riscv_vmv_v_x_u32m8(0, vl);
+    vuint32m8_t hi = __riscv_vmv_v_x_u32m8(K - 1, vl);
+    while (true) {
+        vbool4_t active = __riscv_vmsltu_vv_u32m8_b4(lo, hi, vl);
+        if (__riscv_vfirst_m_b4(active, vl) < 0) {
+            break;
+        }
+        vuint32m8_t mid =
+                __riscv_vsrl_vx_u32m8(__riscv_vadd_vv_u32m8(lo, hi, vl), 1, vl);
+        vfloat32m8_t b = __riscv_vluxei32_v_f32m8(
+                boundaries, __riscv_vminu_vx_u32m8(mid, K - 2, vl), vl);
+        vbool4_t take = __riscv_vmfle_vv_f32m8_b4(b, x, vl);
+        vbool4_t mt = __riscv_vmand_mm_b4(active, take, vl);
+        vbool4_t mf =
+                __riscv_vmand_mm_b4(active, __riscv_vmnot_m_b4(take, vl), vl);
+        lo = __riscv_vmerge_vvm_u32m8(
+                lo, __riscv_vadd_vx_u32m8(mid, 1, vl), mt, vl);
+        hi = __riscv_vmerge_vvm_u32m8(hi, mid, mf, vl);
+    }
+    return lo;
+}
