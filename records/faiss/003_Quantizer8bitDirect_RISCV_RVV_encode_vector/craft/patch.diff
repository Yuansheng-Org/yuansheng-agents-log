+    /// RVV precision-conversion fast path for code[i] = (uint8_t)x[i].
+    ///
+    /// The scalar lowering of `(uint8_t)x[i]` on RISC-V is
+    /// flw / fcvt.wu.s (rtz) / sb: float -> u32 with round-toward-zero and
+    /// saturation (negative -> 0, overflow/NaN -> 0xFFFFFFFF), then the low
+    /// byte is stored. This RVV path reproduces those bytes lane-exactly with
+    /// a dynamic-vsetvl strip-mined loop: vle32 loads, vfcvt.rtz.xu.f.v
+    /// converts f32 -> u32 with the same rtz/saturation semantics as the
+    /// scalar fcvt.wu.s, a pure narrowing shift (vnsrl.wi shift 0,
+    /// u32 -> u16 -> u8) keeps the low byte of each saturated conversion, and
+    /// vse8 stores the result. Each iteration's vl naturally covers the tail
+    /// (partial vl), so zero-length and odd-sized vectors are handled without
+    /// any out-of-bounds access and without changing the codec contract.
+    void encode_vector(const float* x, uint8_t* code) const final {
+        const size_t d = this->d;
+        size_t i = 0;
+        while (i < d) {
+            // Between 1 and VLMAX lanes per chunk; the final chunk is partial.
+            size_t vl = __riscv_vsetvl_e32m1(d - i);
+            vfloat32m1_t xv = __riscv_vle32_v_f32m1(x + i, vl);
+            // Same semantics as scalar fcvt.wu.s rtz (saturates out-of-range
+            // and NaN to 0 / 0xFFFFFFFF as appropriate), then keep the low
+            // byte exactly like the scalar value truncation.
+            vuint32m1_t xu = __riscv_vfcvt_rtz_xu_f_v_u32m1(xv, vl);
+            vuint16mf2_t xu16 = __riscv_vnsrl_wx_u16mf2(xu, 0, vl);
+            vuint8mf4_t xu8 = __riscv_vnsrl_wx_u8mf4(xu16, 0, vl);
+            __riscv_vse8_v_u8mf4(code + i, xu8, vl);
+            i += vl;
+        }
+    }
 };
 
