+#ifdef MNN_USE_RVV
+// 使用更大 LMUL（e8,m8）的字节拷贝，减少循环控制/配置开销。
+// 相较编译器默认的 e8,m1 自动向量化 memcpy，单次迭代覆盖字节数更多。
+static void _memcpyBytesRVV(void* dst, const void* src, size_t n) {
+    uint8_t* d = static_cast<uint8_t*>(dst);
+    const uint8_t* s = static_cast<const uint8_t*>(src);
+    for (size_t vl; n > 0; n -= vl, s += vl, d += vl) {
+        vl = __riscv_vsetvl_e8m8(n);
+        vuint8m8_t v = __riscv_vle8_v_u8m8(s, vl);
+        __riscv_vse8_v_u8m8(d, v, vl);
+    }
+}
+#endif // MNN_USE_RVV
