@@ -0,0 +1,35 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build riscv64
+
+package maps_test
+
+import (
+	"internal/runtime/maps"
+	"testing"
+	"unsafe"
+)
+
+func TestMemHashAlignedFallback(t *testing.T) {
+	for _, size := range []uintptr{32, 64, 128} {
+		buf := make([]byte, size+8)
+		for i := range buf {
+			buf[i] = byte(i*37 + 11)
+		}
+		base := uintptr(unsafe.Pointer(unsafe.SliceData(buf)))
+		offset := uintptr(1)
+		if (base+offset)&7 == 0 {
+			offset++
+		}
+		p := unsafe.Pointer(base + offset)
+		for _, seed := range []uintptr{0, 1, 0x12345678} {
+			got := maps.MemHashAligned(p, seed, size)
+			want := maps.MemHashFallback(p, seed, size)
+			if got != want {
+				t.Fatalf("size=%d seed=%#x: MemHashAligned=%#x, memHashFallback=%#x", size, seed, got, want)
+			}
+		}
+	}
+}
