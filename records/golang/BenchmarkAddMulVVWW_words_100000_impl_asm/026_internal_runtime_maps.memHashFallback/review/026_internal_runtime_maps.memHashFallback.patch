diff --git a/src/internal/runtime/maps/runtime_hash64_align_riscv64.go b/src/internal/runtime/maps/runtime_hash64_align_riscv64.go
new file mode 100644
index 0000000000..a283613692
--- /dev/null
+++ b/src/internal/runtime/maps/runtime_hash64_align_riscv64.go
@@ -0,0 +1,43 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build riscv64
+
+package maps
+
+import "unsafe"
+
+// MemHashAligned hashes a fixed-size key using aligned word loads when the
+// caller-provided pointer permits them. The compiler only selects this entry
+// point for 32-, 64-, and 128-byte memory keys.
+func MemHashAligned(p unsafe.Pointer, seed, s uintptr) uintptr {
+	if uintptr(p)&7 != 0 {
+		return memHashFallback(p, seed, s)
+	}
+
+	seed ^= hashkey[0]
+	l := s
+	if l > 48 {
+		seed1 := seed
+		seed2 := seed
+		for ; l > 48; l -= 48 {
+			seed = mix(readAligned64(p)^hashkey[1], readAligned64(add(p, 8))^seed)
+			seed1 = mix(readAligned64(add(p, 16))^hashkey[2], readAligned64(add(p, 24))^seed1)
+			seed2 = mix(readAligned64(add(p, 32))^hashkey[3], readAligned64(add(p, 40))^seed2)
+			p = add(p, 48)
+		}
+		seed ^= seed1 ^ seed2
+	}
+	for ; l > 16; l -= 16 {
+		seed = mix(readAligned64(p)^hashkey[1], readAligned64(add(p, 8))^seed)
+		p = add(p, 16)
+	}
+	a := readAligned64(add(p, l-16))
+	b := readAligned64(add(p, l-8))
+	return mix(m5^s, mix(a^hashkey[1], b^seed))
+}
+
+func readAligned64(p unsafe.Pointer) uintptr {
+	return uintptr(*(*uint64)(p))
+}
