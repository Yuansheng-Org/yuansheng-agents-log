diff --git a/libavcodec/riscv/me_cmp_rvv.S b/libavcodec/riscv/me_cmp_rvv.S
index 0b7a49bb0c..853420ee0b 100644
--- a/libavcodec/riscv/me_cmp_rvv.S
+++ b/libavcodec/riscv/me_cmp_rvv.S
@@ -542,3 +542,46 @@ func ff_nsse8_rvv, zve32x
 
         ret
 endfunc
+
+/* pix_abs16_xy2: sum |pix1[i] - avg4(pix2[i],pix2[i+1],pix3[i],pix3[i+1])|
+ * avg4 = (a+b+c+d+2)>>2 ; pix3 = pix2 + stride
+ * a0=v a1=pix1 a2=pix2 a3=stride a4=h
+ */
+func ff_pix_abs16_xy2_rvv, zve32x
+        lpad    0
+        csrwi           vxrm, 0
+        vsetivli        zero, 1, e32, m1, ta, ma
+        li              t5, 1
+        vmv.s.x         v0, zero
+1:
+        vsetivli        zero, 17, e8, m2, tu, ma
+        vle8.v          v12, (a2)               /* pix2[0..16] */
+        vslide1down.vx  v24, v12, t5            /* pix2[1..17] */
+        add             a6, a2, a3              /* pix3 */
+        vle8.v          v14, (a6)               /* pix3[0..16] */
+        vslide1down.vx  v26, v14, t5            /* pix3[1..17] */
+        vsetivli        zero, 16, e8, m1, tu, ma
+        vle8.v          v4, (a1)                /* pix1 */
+        vmv.v.i         v28, 1
+        vwmulu.vv       v16, v12, v28           /* p2 */
+        vwmulu.vv       v18, v24, v28           /* p2n */
+        vwmulu.vv       v20, v14, v28           /* p3 */
+        vwmulu.vv       v22, v26, v28           /* p3n */
+        vwmulu.vv       v24, v4, v28            /* pix1 widen */
+        vsetvli         zero, zero, e16, m2, tu, ma
+        vadd.vv         v16, v16, v18
+        vadd.vv         v20, v20, v22
+        vadd.vv         v16, v16, v20
+        vadd.vi         v16, v16, 2
+        vsrl.vi         v16, v16, 2             /* avg4 */
+        vsub.vv         v24, v24, v16
+        vneg.v          v20, v24
+        vmax.vv         v24, v24, v20
+        vwredsum.vs     v0, v24, v0
+        add             a1, a1, a3
+        add             a2, a2, a3
+        addi            a4, a4, -1
+        bnez            a4, 1b
+
+        pix_abs_ret
+endfunc
