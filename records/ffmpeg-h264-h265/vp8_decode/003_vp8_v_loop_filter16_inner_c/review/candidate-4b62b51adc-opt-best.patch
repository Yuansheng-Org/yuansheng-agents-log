+        vsadd.vv   v4, v17, v24
+        vxor.vx    v4, v4, t1
+        vssub.vv   v5, v16, v23
+        vxor.vx    v5, v5, t1
+
+        li         t2, 9
+        vwmul.vx   v24, v22, t2
+        vsetvli    zero, zero, e16, m2, ta, ma
+        vsll.vi    v26, v24, 1
+        vadd.vv    v28, v26, v24
+        li         t2, 63
+        vadd.vx    v24, v24, t2
+        vadd.vx    v26, v26, t2
+        vadd.vx    v28, v28, t2
+        vsetvli    zero, zero, e8, m1, ta, ma
+        vnsra.wi   v6, v24, 7
+        vnsra.wi   v7, v26, 7
+        vnsra.wi   v30, v28, 7
+
+        vsadd.vv   v24, v17, v30
+        vxor.vx    v24, v24, t1
+        vssub.vv   v25, v16, v30
+        vxor.vx    v25, v25, t1
+        vsadd.vv   v26, v19, v7
+        vxor.vx    v26, v26, t1
+        vssub.vv   v27, v20, v7
