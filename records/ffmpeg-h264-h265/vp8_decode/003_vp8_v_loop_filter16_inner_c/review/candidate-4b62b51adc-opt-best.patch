+.macro vp8lf_y suffix, core
+func ff_vp8_v_loop_filter16\suffix\()_rvv, zve32x
+        lpad       0
+        vsetivli   zero, 16, e8, m1, ta, ma
+        slli       t2, a1, 2
+        sub        t1, a0, t2
+        vp8lf_load8 t1, a1, v8, v9, v10, v11, v12, v13, v14, v15
+        jal        t0, .Lvp8lf_\core
+.ifc \core,inner
+        slli       t2, a1, 1
+        sub        t1, a0, t2
+        vp8lf_store4 t1, a1, v10, v11, v12, v13
+.else
+        slli       t2, a1, 1
+        add        t2, t2, a1
+        sub        t1, a0, t2
+        vp8lf_store6 t1, a1, v9, v10, v11, v12, v13, v14
+.endif
+        ret
+endfunc
+.endm
+
+.macro vp8lf_uv suffix, core
+func ff_vp8_v_loop_filter8uv\suffix\()_rvv, zve32x
+        lpad       0
+        mv         t4, a2
+        vsetivli   zero, 8, e8, mf2, ta, ma
+        slli       t3, t4, 2
+        sub        t1, a0, t3
+        sub        t2, a1, t3
+        vp8lf_load8 t1, t4, v8, v9, v10, v11, v12, v13, v14, v15
+        vp8lf_load8 t2, t4, v16, v17, v18, v19, v20, v21, v22, v23
+        vp8lf_pack_uv
+        mv         a2, a3
+        mv         a3, a4
+        mv         a4, a5
+        jal        t0, .Lvp8lf_\core
+.ifc \core,inner
+        vslidedown.vi v24, v10, 8
+        vslidedown.vi v25, v11, 8
+        vslidedown.vi v26, v12, 8
+        vslidedown.vi v27, v13, 8
+.else
+        vslidedown.vi v24, v9,  8
+        vslidedown.vi v25, v10, 8
+        vslidedown.vi v26, v11, 8
+        vslidedown.vi v27, v12, 8
+        vslidedown.vi v28, v13, 8
+        vslidedown.vi v29, v14, 8
+.endif
+        vsetivli   zero, 8, e8, mf2, ta, ma
+.ifc \core,inner
+        slli       t3, t4, 1
+        sub        t1, a0, t3
+        sub        t2, a1, t3
+        vp8lf_store4 t1, t4, v10, v11, v12, v13
+        vp8lf_store4 t2, t4, v24, v25, v26, v27
+.else
+        slli       t3, t4, 1
+        add        t3, t3, t4
+        sub        t1, a0, t3
+        sub        t2, a1, t3
+        vp8lf_store6 t1, t4, v9, v10, v11, v12, v13, v14
+        vp8lf_store6 t2, t4, v24, v25, v26, v27, v28, v29
+.endif
+        ret
+endfunc
+.endm
