+.macro vp8lf_abs_u8 dst, tmp, x, y
+        vssubu.vv  \dst, \x, \y
+        vssubu.vv  \tmp, \y, \x
+        vor.vv     \dst, \dst, \tmp
+.endm
+
+.macro vp8lf_load8 base, stride, p3, p2, p1, p0, q0, q1, q2, q3
+        vle8.v     \p3, (\base)
+        add        \base, \base, \stride
+        vle8.v     \p2, (\base)
+        add        \base, \base, \stride
+        vle8.v     \p1, (\base)
+        add        \base, \base, \stride
+        vle8.v     \p0, (\base)
+        add        \base, \base, \stride
+        vle8.v     \q0, (\base)
+        add        \base, \base, \stride
+        vle8.v     \q1, (\base)
+        add        \base, \base, \stride
+        vle8.v     \q2, (\base)
+        add        \base, \base, \stride
+        vle8.v     \q3, (\base)
+.endm
+
+.macro vp8lf_store4 base, stride, p1, p0, q0, q1
+        vse8.v     \p1, (\base)
+        add        \base, \base, \stride
+        vse8.v     \p0, (\base)
+        add        \base, \base, \stride
+        vse8.v     \q0, (\base)
+        add        \base, \base, \stride
+        vse8.v     \q1, (\base)
+.endm
+
+.macro vp8lf_store6 base, stride, p2, p1, p0, q0, q1, q2
+        vse8.v     \p2, (\base)
+        add        \base, \base, \stride
+        vse8.v     \p1, (\base)
+        add        \base, \base, \stride
+        vse8.v     \p0, (\base)
+        add        \base, \base, \stride
+        vse8.v     \q0, (\base)
+        add        \base, \base, \stride
+        vse8.v     \q1, (\base)
+        add        \base, \base, \stride
+        vse8.v     \q2, (\base)
+.endm
+
+.macro vp8lf_pack_uv
+        vsetivli   zero, 16, e8, m1, ta, ma
+        vslideup.vi v8,  v16, 8
+        vslideup.vi v9,  v17, 8
+        vslideup.vi v10, v18, 8
+        vslideup.vi v11, v19, 8
+        vslideup.vi v12, v20, 8
+        vslideup.vi v13, v21, 8
+        vslideup.vi v14, v22, 8
+        vslideup.vi v15, v23, 8
+.endm
+
