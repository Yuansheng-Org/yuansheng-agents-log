+        vsaddu.vv  v16, v16, v18
+        vmsleu.vx  v3, v16, a2
+        vmand.mm   v1, v1, v3
+        vmandn.mm  v3, v1, v2
+
+        li         t1, 0x80
+        vxor.vx    v16, v12, t1
+        vxor.vx    v17, v11, t1
+        vssub.vv   v18, v16, v17
+        vxor.vx    v19, v10, t1
+        vxor.vx    v20, v13, t1
+        vssub.vv   v21, v19, v20
+.if \inner
+        vmv.v.i    v22, 0
+        vmmv.m     v0, v2
+        vmerge.vvm v22, v22, v21, v0
+.else
+        vmv.v.v    v22, v21
+.endif
+        vsadd.vv   v22, v22, v18
+        vsadd.vv   v22, v22, v18
+        vsadd.vv   v22, v22, v18
+        vsadd.vi   v23, v22, 4
+        vsra.vi    v23, v23, 3
+        vsadd.vi   v24, v22, 3
+        vsra.vi    v24, v24, 3
+
+.if \inner
+        vsadd.vv   v25, v17, v24
+        vxor.vx    v25, v25, t1
+        vssub.vv   v26, v16, v23
+        vxor.vx    v26, v26, t1
+        vmmv.m     v0, v1
+        vmerge.vvm v11, v11, v25, v0
+        vmerge.vvm v12, v12, v26, v0
+
+        vadd.vi    v25, v23, 1
+        vsra.vi    v25, v25, 1
+        vsadd.vv   v26, v19, v25
+        vxor.vx    v26, v26, t1
+        vssub.vv   v27, v20, v25
+        vxor.vx    v27, v27, t1
+        vmmv.m     v0, v3
+        vmerge.vvm v10, v10, v26, v0
+        vmerge.vvm v13, v13, v27, v0
