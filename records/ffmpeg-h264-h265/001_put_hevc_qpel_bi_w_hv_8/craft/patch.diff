+
+#include "libavutil/riscv/asm.S"
+
+/* HEVC qpel/epel weighted-pel RVV kernels.
+ *
+ * Semantics from libavcodec/hevc/dsp_template.c (bi_w family) and
+ * libavcodec/h26x/h2656_inter_template.c (uni_w family).
+ *
+ * Calling convention: up to 13 arguments; a0-a7 in registers, the rest
+ * (wx1, ox, mx, my, width) arrive on the stack at sp+0..32.
+ *
+ * Frame: sp+0..512 args/coeffs/saved regs, sp+512..12800 tmp buffer.
+ * s0 = tmp base, s1-s8 = filter coeffs, s9 = ox'<<log2Wd (bi_w) / ox' (uni_w),
+ * s10 = log2Wd (bi_w) / shift (uni_w).
+ */
+
+        .section .rodata
+        .align 6
+hevc_local_qpel_filters:
+        .byte 0, 0, 0, 0, 0, 0, 0, 0
+        .byte -1, 4, -10, 58, 17, -5, 1, 0
+        .byte -1, 4, -11, 40, 40, -11, 4, -1
+        .byte 0, 1, -5, 17, 58, -10, 4, -1
+hevc_local_epel_filters:
+        .byte 0, 0, 0, 0
+        .byte -2, 58, 10, -2
+        .byte -4, 54, 16, -2
+        .byte -6, 46, 28, -4
+        .byte -4, 36, 36, -4
+        .byte -4, 28, 46, -6
+        .byte -2, 16, 54, -4
+        .byte -2, 10, 58, -2
+
+/* Load 8 signed coefficients of row idx into s1..s8. clobbers t0,t1 */
+.macro hevc_coeffs tbl, idx, tap
+        .option push
+        .option nopic
+        la      t0, \tbl
+        .option pop
+    .ifc \tap, qpel
+        slli    t1, \idx, 3
+    .else
+        slli    t1, \idx, 2
+    .endif
+        add     t0, t0, t1
+        lb      s1, 0(t0)
+        lb      s2, 1(t0)
+        lb      s3, 2(t0)
+        lb      s4, 3(t0)
+    .ifc \tap, qpel
+        lb      s5, 4(t0)
+        lb      s6, 5(t0)
+        lb      s7, 6(t0)
+        lb      s8, 7(t0)
+    .else
+        li      s5, 0
+        li      s6, 0
+        li      s7, 0
+        li      s8, 0
+    .endif
+.endm
+
+/* Horizontal 8-tap accumulate of one row into acc. Row ptr t3, pixel size ps. */
+.macro hevc_h8 acc, ps
+    .if \ps == 1
+        vle8.v  v0, (t3)
+        addi    t1, t3, -1
+        vle8.v  v1, (t1)
+        addi    t1, t3, -2
+        vle8.v  v2, (t1)
+        addi    t1, t3, -3
+        vle8.v  v3, (t1)
+        addi    t1, t3, 1
+        vle8.v  v4, (t1)
+        addi    t1, t3, 2
+        vle8.v  v5, (t1)
+        addi    t1, t3, 3
+        vle8.v  v6, (t1)
+        addi    t1, t3, 4
+        vle8.v  v7, (t1)
+    .else
+        vle16.v v0, (t3)
+        addi    t1, t3, -2
+        vle16.v v1, (t1)
+        addi    t1, t3, -4
+        vle16.v v2, (t1)
+        addi    t1, t3, -6
+        vle16.v v3, (t1)
+        addi    t1, t3, 2
+        vle16.v v4, (t1)
+        addi    t1, t3, 4
+        vle16.v v5, (t1)
+        addi    t1, t3, 6
+        vle16.v v6, (t1)
+        addi    t1, t3, 8
+        vle16.v v7, (t1)
+    .endif
+        vwmaccsu.vx \acc, s1, v3
+        vwmaccsu.vx \acc, s2, v2
+        vwmaccsu.vx \acc, s3, v1
+        vwmaccsu.vx \acc, s4, v0
+        vwmaccsu.vx \acc, s5, v4
+        vwmaccsu.vx \acc, s6, v5
+        vwmaccsu.vx \acc, s7, v6
+        vwmaccsu.vx \acc, s8, v7
+.endm
+
+/* Horizontal 4-tap (epel) accumulate into acc. */
+.macro hevc_h4 acc, ps
+    .if \ps == 1
+        vle8.v  v0, (t3)
+        addi    t1, t3, -1
+        vle8.v  v1, (t1)
+        addi    t1, t3, 1
+        vle8.v  v2, (t1)
+        addi    t1, t3, 2
+        vle8.v  v3, (t1)
+    .else
+        vle16.v v0, (t3)
+        addi    t1, t3, -2
+        vle16.v v1, (t1)
+        addi    t1, t3, 2
+        vle16.v v2, (t1)
+        addi    t1, t3, 4
+        vle16.v v3, (t1)
+    .endif
+        vwmaccsu.vx \acc, s1, v1
+        vwmaccsu.vx \acc, s2, v0
+        vwmaccsu.vx \acc, s3, v2
+        vwmaccsu.vx \acc, s4, v3
+.endm
+
+/* Shift e32 acc (v8) by bshift and store e16 to tmp row (t4). */
+.macro hevc_store_tmp bshift
+    .if \bshift > 0
+        vsetvli zero, zero, e32, m2, ta, ma
+        vsra.vi v8, v8, \bshift
+        vnsrl.wi v9, v8, 0
+        vsetvli zero, zero, e16, m2, ta, ma
+        vse16.v v9, (t4)
+    .else
+        vsetvli zero, zero, e16, m2, ta, ma
+        vse16.v v8, (t4)
+    .endif
+.endm
+
+/* bi_w combine of e32 acc v16. a4=src2 row, t4=dst row, t5=vl, t2=width. */
+.macro hevc_combine_biw depth, clip, ps, ishv
+        vsetvli zero, zero, e32, m4, ta, ma
+    .if \ishv
+        li      t1, 6
+        vsra.vx v16, v16, t1
+    .endif
+        lw      t1, 32(sp)
+        vmul.vx v16, v16, t1
+        vsetvli zero, zero, e16, m2, ta, ma
+        vle16.v v18, (a4)
+        lw      t1, 28(sp)
+        vwmul.vx v20, v18, t1
+        vsetvli zero, zero, e32, m4, ta, ma
+        vadd.vv v16, v16, v20
+        vadd.vx v16, v16, s9
+        mv      t1, s10
+        addi    t1, t1, 1
+        vsra.vx v16, v16, t1
+        vmax.vx v16, v16, zero
+        li      t1, \clip
+        vmin.vx v16, v16, t1
+        vsetvli zero, zero, e32, m4, ta, ma
+        vnsrl.wi v9, v16, 0
+    .if \ps == 1
+        vsetvli zero, zero, e16, m2, ta, ma
+        vnsrl.wi v9, v9, 0
+        vsetvli zero, zero, e8, m2, ta, ma
+        vse8.v v9, (t4)
+    .else
+        vsetvli zero, zero, e16, m2, ta, ma
+        vse16.v v9, (t4)
+    .endif
+.endm
+
+/* uni_w combine of e32 acc v16. s9=ox', s10=shift. */
+.macro hevc_combine_uniw depth, clip, ps, ishv
+        vsetvli zero, zero, e32, m4, ta, ma
+    .if \ishv
+        li      t1, 6
+        vsra.vx v16, v16, t1
+    .endif
+        lw      t1, 24(sp)              /* wx (a6) */
+        vmul.vx v16, v16, t1
+        mv      t1, s10
+        addi    t1, t1, -1
+        li      a6, 1
+        sll     t1, a6, t1
+        vadd.vx v16, v16, t1
+        mv      t1, s10
+        vsra.vx v16, v16, t1
+        vadd.vx v16, v16, s9
+        vmax.vx v16, v16, zero
+        li      t1, \clip
+        vmin.vx v16, v16, t1
+        vsetvli zero, zero, e32, m4, ta, ma
+        vnsrl.wi v9, v16, 0
+    .if \ps == 1
+        vsetvli zero, zero, e16, m2, ta, ma
+        vnsrl.wi v9, v9, 0
+        vsetvli zero, zero, e8, m2, ta, ma
+        vse8.v v9, (t4)
+    .else
+        vsetvli zero, zero, e16, m2, ta, ma
+        vse16.v v9, (t4)
+    .endif
+.endm
+
+/* Dispatch combine by op. */
+.macro hevc_combine_sel op, depth, clip, ps, ishv
+    .ifc \op, bi_w
+        hevc_combine_biw \depth, \clip, \ps, \ishv
+    .else
+        hevc_combine_uniw \depth, \clip, \ps, \ishv
+    .endif
+.endm
+
+/* Reload src2 row pointer for current row (r = height - t0). */
+.macro hevc_reload_src2 op, heightsp
+    .ifc \op, bi_w
+        lw      t1, \heightsp
+        sub     t1, t1, t0
+        slli    t1, t1, 7
+        lw      a4, 16(sp)
+        add     a4, a4, t1
+    .endif
+.endm
+
+/* Advance row pointers after a combine. t5=vl(e16). */
+.macro hevc_advance ps, t3mul
+    .if \t3mul == 1
+        add     t3, t3, t5              /* src (e8): vl bytes */
+    .else
+        slli    t1, t5, 1
+        add     t3, t3, t1              /* src (e16) or tmp: vl*2 bytes */
+    .endif
+        slli    t1, t5, 1
+        add     a4, a4, t1              /* src2: vl*2 bytes per tile */
+    .if \ps == 1
+        add     t4, t4, t5
+    .else
+        add     t4, t4, t1
+    .endif
+        sub     t2, t2, t5
+.endm
+
+/* Shared prologue for all hevc_pel_w_* functions.
+ * Reads the 5 stack args, saves all args + s-regs, sets up tmp.
+ * \ps needed for srcstride handling. Clobbers t0-t5.
+ */
+.macro hevc_prologue op
+    .ifc \op, bi_w
+        lw      t1, 0(sp)               /* wx1 */
+        lw      t2, 8(sp)               /* ox */
+        lw      t3, 16(sp)              /* mx */
+        lw      t4, 24(sp)              /* my */
+        lw      t5, 32(sp)              /* width */
+    .else
+        lw      t3, 0(sp)               /* mx */
+        lw      t4, 8(sp)               /* my */
+        lw      t5, 16(sp)              /* width */
+        li      t1, 0                   /* wx1 unused */
+        li      t2, 0                   /* ox unused */
+    .endif
+        li      t0, 12800
+        sub     sp, sp, t0
+        sw      a0,  0(sp)
+        sw      a1,  4(sp)
+        sw      a2,  8(sp)
+        sw      a3,  12(sp)
+        sw      a4,  16(sp)
+        sw      a5,  20(sp)
+        sw      a6,  24(sp)
+        sw      a7,  28(sp)
+        sw      t1, 32(sp)
+        sw      t2, 36(sp)
+        sw      t3, 40(sp)
+        sw      t4, 44(sp)
+        sw      t5, 48(sp)
+        sd      ra,  56(sp)
+        sd      s0,  64(sp)
+        sd      s1,  72(sp)
+        sd      s2,  80(sp)
+        sd      s3,  88(sp)
+        sd      s4,  96(sp)
+        sd      s5,  104(sp)
+        sd      s6,  112(sp)
+        sd      s7,  120(sp)
+        sd      s8,  128(sp)
+        sd      s9,  136(sp)
+        sd      s10, 144(sp)
+        sd      s11, 152(sp)
+        addi    s0, sp, 512
+.endm
+
+/* Shared epilogue. */
+.macro hevc_epilogue
+        ld      ra,  56(sp)
+        ld      s0,  64(sp)
+        ld      s1,  72(sp)
+        ld      s2,  80(sp)
+        ld      s3,  88(sp)
+        ld      s4,  96(sp)
+        ld      s5,  104(sp)
+        ld      s6,  112(sp)
+        ld      s7,  120(sp)
+        ld      s8,  128(sp)
+        ld      s9,  136(sp)
+        ld      s10, 144(sp)
+        ld      s11, 152(sp)
+        li      t0, 12800
+        add     sp, sp, t0
+        addi    sp, sp, 512
+        ret
+.endm
+
+/* Common entry: constants (s9/s10), mx/my coeffs stored to stack.
+ * \op, \depth, \ps, \bshift, \clip, \bdoff, \bdu, \tbl are macro args.
+ */
+.macro hevc_consts op, tap, depth, ps, bshift, clip, bdoff, bdu, tbl
+        lw      a2, 8(sp)
+        lw      a3, 12(sp)
+    .ifc \op, bi_w
+        lw      t0, 24(sp)              /* denom (a6) */
+        addi    t0, t0, \bdoff
+        mv      s10, t0
+        lw      t0, 36(sp)
+    .if \bshift > 0
+        slli    t0, t0, \bshift
+    .endif
+        addi    t0, t0, 1
+        sll     s9, t0, s10
+    .else
+        lw      t0, 20(sp)              /* denom (a5) */
+        addi    t0, t0, \bdu
+        mv      s10, t0
+        lw      t0, 28(sp)              /* ox (a7) */
+    .if \bshift > 0
+        slli    t0, t0, \bshift
+    .endif
+        mv      s9, t0
+    .endif
+        lw      t1, 40(sp)
+        hevc_coeffs \tbl, t1, \tap
+        sd      s1, 160(sp)
+        sd      s2, 168(sp)
+        sd      s3, 176(sp)
+        sd      s4, 184(sp)
+        sd      s5, 192(sp)
+        sd      s6, 200(sp)
+        sd      s7, 208(sp)
+        sd      s8, 216(sp)
+        lw      t1, 44(sp)
+        hevc_coeffs \tbl, t1, \tap
+        sd      s1, 224(sp)
+        sd      s2, 232(sp)
+        sd      s3, 240(sp)
+        sd      s4, 248(sp)
+        sd      s5, 256(sp)
+        sd      s6, 264(sp)
+        sd      s7, 272(sp)
+        sd      s8, 280(sp)
+.endm
+
+.macro hevc_load_height op
+    .ifc \op, bi_w
+        lw      t0, 20(sp)              /* height (a5) */
+    .else
+        lw      t0, 16(sp)              /* height (a4) */
+    .endif
+.endm
+
+/* Row-advance helpers by pixel size. */
+.macro hevc_src_row_inc ps
+        add     a2, a2, a3              /* a3 is the byte srcstride */
+.endm
+.macro hevc_dst_row_inc
+        lw      t1, 4(sp)
+        lw      t5, 0(sp)
+        add     t5, t5, t1
+        sw      t5, 0(sp)
+.endm
+.macro hevc_src2_row_inc
+        addi    a4, a4, 128
+.endm
+
+/* ---------------------------------------------------------------- */
+/* _h variants: horizontal filter + combine, no tmp                  */
+/* ---------------------------------------------------------------- */
+.macro hevc_pel_w_h op, tap, depth, ps, bshift, clip, bdoff, bdu, tbl
+func ff_put_hevc_\tap\()_\op\()_h_\depth\()_rvv, zve32x
+        lpad    0
+        hevc_prologue \op
+        hevc_consts \op, \tap, \depth, \ps, \bshift, \clip, \bdoff, \bdu, \tbl
+        ld      s1, 160(sp)
+        ld      s2, 168(sp)
+        ld      s3, 176(sp)
+        ld      s4, 184(sp)
+        ld      s5, 192(sp)
+        ld      s6, 200(sp)
+        ld      s7, 208(sp)
+        ld      s8, 216(sp)
+        hevc_load_height \op
+1:      lw      t2, 48(sp)
+        hevc_reload_src2 \op, 20(sp)
+        mv      t3, a2
+        lw      t4, 0(sp)
+2:    .if \ps == 1
+        vsetvli t5, t2, e8, m1, ta, ma
+    .else
+        vsetvli t5, t2, e16, m1, ta, ma
+    .endif
+        vmv.v.i v8, 0
+    .ifc \tap, qpel
+        hevc_h8 v8, \ps
+    .else
+        hevc_h4 v8, \ps
+    .endif
