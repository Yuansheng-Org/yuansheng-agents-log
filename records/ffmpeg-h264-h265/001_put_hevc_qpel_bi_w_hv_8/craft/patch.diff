+    .if \ps == 1
+        vle8.v  v1, (t1)
+    .else
+        vle16.v v1, (t1)
+    .endif
+        add     t1, t1, a3
+    .if \ps == 1
+        vle8.v  v2, (t1)
+    .else
+        vle16.v v2, (t1)
+    .endif
+        add     t1, t1, a3
+    .if \ps == 1
+        vle8.v  v3, (t1)
+    .else
+        vle16.v v3, (t1)
+    .endif
+        add     t1, t1, a3
+    .if \ps == 1
+        vle8.v  v4, (t1)
+    .else
+        vle16.v v4, (t1)
+    .endif
+        add     t1, t1, a3
+    .if \ps == 1
+        vle8.v  v5, (t1)
+    .else
+        vle16.v v5, (t1)
+    .endif
+        add     t1, t1, a3
+    .if \ps == 1
+        vle8.v  v6, (t1)
+    .else
+        vle16.v v6, (t1)
+    .endif
+        add     t1, t1, a3
+    .if \ps == 1
+        vle8.v  v7, (t1)
+    .else
+        vle16.v v7, (t1)
+    .endif
