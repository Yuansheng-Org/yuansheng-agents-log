+        addi    t1, t1, 128
+        vle16.v v2, (t1)
+        addi    t1, t1, 128
+        vle16.v v3, (t1)
+        addi    t1, t1, 128
+        vle16.v v4, (t1)
+        addi    t1, t1, 128
+        vle16.v v5, (t1)
+        addi    t1, t1, 128
+        vle16.v v6, (t1)
+        addi    t1, t1, 128
