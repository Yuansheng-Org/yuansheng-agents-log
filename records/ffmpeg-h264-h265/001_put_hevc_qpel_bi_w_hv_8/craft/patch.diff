+        addi    t6, t6, 128
+        addi    t0, t0, -1
+        bnez    t0, 1b
+        ld      s1, 224(sp)
+        ld      s2, 232(sp)
+        ld      s3, 240(sp)
+        ld      s4, 248(sp)
+        ld      s5, 256(sp)
+        ld      s6, 264(sp)
+        ld      s7, 272(sp)
+        ld      s8, 280(sp)
+        hevc_load_height \op
+    .ifc \tap, qpel
+        addi    t6, s0, 3 * 128
+    .else
+        addi    t6, s0, 1 * 128
+    .endif
+3:      lw      t2, 48(sp)
