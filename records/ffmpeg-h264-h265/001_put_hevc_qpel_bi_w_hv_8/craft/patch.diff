+        mv      t3, t6
+        lw      t4, 0(sp)
+4:    .if \ps == 1
+        vsetvli t5, t2, e8, m1, ta, ma
+    .else
+        vsetvli t5, t2, e16, m1, ta, ma
+    .endif
+        vmv.v.i v8, 0
+        mv      t1, t3
+    .ifc \tap, qpel
+        sub     t1, t1, a3
+        sub     t1, t1, a3
+        sub     t1, t1, a3
+    .if \ps == 1
+        vle8.v  v0, (t1)
+    .else
+        vle16.v v0, (t1)
+    .endif
