+        vwmaccsu.vx v8, s2, v1
+        vwmaccsu.vx v8, s3, v2
+        vwmaccsu.vx v8, s4, v3
+        vwmaccsu.vx v8, s5, v4
+        vwmaccsu.vx v8, s6, v5
+        vwmaccsu.vx v8, s7, v6
+        vwmaccsu.vx v8, s8, v7
+    .else
+        sub     t1, t1, a3
+    .if \ps == 1
+        vle8.v  v0, (t1)
+    .else
+        vle16.v v0, (t1)
+    .endif
+        add     t1, t1, a3
+    .if \ps == 1
+        vle8.v  v1, (t1)
+    .else
+        vle16.v v1, (t1)
+    .endif
+        add     t1, t1, a3
+    .if \ps == 1
+        vle8.v  v2, (t1)
+    .else
+        vle16.v v2, (t1)
+    .endif
+        add     t1, t1, a3
+    .if \ps == 1
+        vle8.v  v3, (t1)
+    .else
+        vle16.v v3, (t1)
+    .endif
+        vwmaccsu.vx v8, s1, v0
+        vwmaccsu.vx v8, s2, v1
+        vwmaccsu.vx v8, s3, v2
+        vwmaccsu.vx v8, s4, v3
+    .endif
+    .if \ps == 1
+        vsetvli zero, zero, e16, m2, ta, ma
+        vsetvli zero, zero, e32, m4, ta, ma
+    .else
+        vsetvli zero, zero, e32, m4, ta, ma
+    .endif
