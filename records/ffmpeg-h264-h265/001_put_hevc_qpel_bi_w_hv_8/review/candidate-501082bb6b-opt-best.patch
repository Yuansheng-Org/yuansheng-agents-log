index 0299215120..b2cabcfe92 100644
--- a/libavcodec/riscv/Makefile
+++ b/libavcodec/riscv/Makefile
@@ -39,6 +39,8 @@ OBJS-$(CONFIG_H264QPEL) += riscv/h264qpel_init.o
 RVV-OBJS-$(CONFIG_H264QPEL) += riscv/h264qpel_rvv.o
 OBJS-$(CONFIG_HEVC_DECODER) += riscv/hevcdsp_init.o
 RVV-OBJS-$(CONFIG_HEVC_DECODER) += riscv/hevcdsp_idct_rvv.o
+RVV-OBJS-$(CONFIG_HEVC_DECODER) += riscv/h26x/hevcdsp_weighted.o \
+                                  riscv/h26x/hevcdsp_weighted_rvv.o
 RVV-OBJS-$(CONFIG_HEVC_DECODER)  += riscv/h26x/h2656_inter_rvv.o
 OBJS-$(CONFIG_HUFFYUV_DECODER) += riscv/huffyuvdsp_init.o
 RVV-OBJS-$(CONFIG_HUFFYUV_DECODER) += riscv/huffyuvdsp_rvv.o
diff --git a/libavcodec/riscv/h26x/h2656dsp.h b/libavcodec/riscv/h26x/h2656dsp.h
index 6d2ac55556..4dde722d2a 100644
--- a/libavcodec/riscv/h26x/h2656dsp.h
+++ b/libavcodec/riscv/h26x/h2656dsp.h
@@ -24,4 +24,39 @@
 void ff_h2656_put_pixels_8_rvv_256(int16_t *dst, const uint8_t *src, ptrdiff_t srcstride, int height, intptr_t mx, intptr_t my, int width);
 void ff_h2656_put_pixels_8_rvv_128(int16_t *dst, const uint8_t *src, ptrdiff_t srcstride, int height, intptr_t mx, intptr_t my, int width);
 
+#define HEVC_PEL_W_DECLS(pel, D) \
+void ff_put_hevc_##pel##_uni_w_h_##D##_rvv(uint8_t *dst, ptrdiff_t dststride, \
+                                            const uint8_t *src, ptrdiff_t srcstride, \
+                                            int height, int denom, int wx, int ox, \
+                                            intptr_t mx, intptr_t my, int width); \
+void ff_put_hevc_##pel##_uni_w_v_##D##_rvv(uint8_t *dst, ptrdiff_t dststride, \
+                                            const uint8_t *src, ptrdiff_t srcstride, \
+                                            int height, int denom, int wx, int ox, \
+                                            intptr_t mx, intptr_t my, int width); \
+void ff_put_hevc_##pel##_uni_w_hv_##D##_rvv(uint8_t *dst, ptrdiff_t dststride, \
+                                             const uint8_t *src, ptrdiff_t srcstride, \
+                                             int height, int denom, int wx, int ox, \
+                                             intptr_t mx, intptr_t my, int width); \
+void ff_put_hevc_##pel##_bi_w_h_##D##_rvv(uint8_t *dst, ptrdiff_t dststride, \
+                                           const uint8_t *src, ptrdiff_t srcstride, \
+                                           const int16_t *src2, int height, int denom, \
+                                           int wx0, int wx1, int ox, intptr_t mx, \
+                                           intptr_t my, int width); \
+void ff_put_hevc_##pel##_bi_w_v_##D##_rvv(uint8_t *dst, ptrdiff_t dststride, \
+                                           const uint8_t *src, ptrdiff_t srcstride, \
+                                           const int16_t *src2, int height, int denom, \
+                                           int wx0, int wx1, int ox, intptr_t mx, \
+                                           intptr_t my, int width); \
+void ff_put_hevc_##pel##_bi_w_hv_##D##_rvv(uint8_t *dst, ptrdiff_t dststride, \
+                                            const uint8_t *src, ptrdiff_t srcstride, \
+                                            const int16_t *src2, int height, int denom, \
+                                            int wx0, int wx1, int ox, intptr_t mx, \
+                                            intptr_t my, int width);
+HEVC_PEL_W_DECLS(qpel, 8)
+HEVC_PEL_W_DECLS(qpel, 9)
+HEVC_PEL_W_DECLS(qpel, 10)
+HEVC_PEL_W_DECLS(qpel, 12)
+HEVC_PEL_W_DECLS(epel, 8)
