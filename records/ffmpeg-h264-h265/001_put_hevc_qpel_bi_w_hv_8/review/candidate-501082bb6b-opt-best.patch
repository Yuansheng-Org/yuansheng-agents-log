 #endif
diff --git a/libavcodec/riscv/h26x/hevcdsp_weighted.c b/libavcodec/riscv/h26x/hevcdsp_weighted.c
new file mode 100644
index 0000000000..146bce28e6
--- /dev/null
+++ b/libavcodec/riscv/h26x/hevcdsp_weighted.c
@@ -0,0 +1,155 @@
+/*
+ * Copyright (c) 2026 Fei Zhang
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
