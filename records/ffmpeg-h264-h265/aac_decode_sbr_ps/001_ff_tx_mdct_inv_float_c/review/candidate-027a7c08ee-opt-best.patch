+#define TX_FLOAT
+#include "libavutil/tx_priv.h"
+#include "libavutil/riscv/cpu.h"
+
+#if HAVE_RVV && (__riscv_xlen == 64)
+TX_DECL_FN(mdct_inv, rvv)
+
+static av_cold int rvv_mdct_init(AVTXContext *s, const FFTXCodelet *cd,
+                                 uint64_t flags, FFTXCodeletOptions *opts,
+                                 int len, int inv, const void *scale)
+{
+    if (!(av_get_cpu_flags() & AV_CPU_FLAG_RVV_I64))
+        return AVERROR(ENOSYS);
+    return ff_tx_mdct_init_float(s, cd, flags, opts, len, inv, scale);
+}
+#endif
+
+const FFTXCodelet * const ff_tx_codelet_list_float_riscv[] = {
+#if HAVE_RVV && (__riscv_xlen == 64)
+    &(const FFTXCodelet){
+        .name       = NULL_IF_CONFIG_SMALL("mdct_inv_float_rvv"),
+        .function   = ff_tx_mdct_inv_float_rvv,
+        .type       = TX_TYPE(MDCT),
+        .flags      = FF_TX_ALIGNED | FF_TX_OUT_OF_PLACE | FF_TX_INVERSE_ONLY,
+        .factors    = { 2, TX_FACTOR_ANY },
+        .nb_factors = 2,
+        .min_len    = 64,
+        .max_len    = TX_LEN_UNLIMITED,
+        .init       = rvv_mdct_init,
+        .cpu_flags  = AV_CPU_FLAG_RVV_F32,
+        .prio       = 128,
+    },
+#endif
+    NULL,
+};
diff --git a/libavutil/riscv/tx_float_rvv.S b/libavutil/riscv/tx_float_rvv.S
new file mode 100644
index 0000000000..8e5b67339a
--- /dev/null
+++ b/libavutil/riscv/tx_float_rvv.S
@@ -0,0 +1,151 @@
+/*
