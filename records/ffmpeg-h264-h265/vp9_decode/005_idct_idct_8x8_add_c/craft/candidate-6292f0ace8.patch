diff --git a/libavcodec/riscv/vp9itxfm_rvv.S b/libavcodec/riscv/vp9itxfm_rvv.S
new file mode 100644
index 0000000000..77124942f4
--- /dev/null
+++ b/libavcodec/riscv/vp9itxfm_rvv.S
@@ -0,0 +1,460 @@
