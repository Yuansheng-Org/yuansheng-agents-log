diff --git a/libavfilter/riscv/vf_blend_init.c b/libavfilter/riscv/vf_blend_init.c
new file mode 100644
index 0000000000..1e2c86ae28
--- /dev/null
+++ b/libavfilter/riscv/vf_blend_init.c
@@ -0,0 +1,87 @@
+/*
+ * Copyright (c) 2013 Paul B Mahol
+ *
+ * This file is part of FFmpeg.
