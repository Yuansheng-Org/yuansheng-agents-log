+
+#include "libavutil/riscv/asm.S"
+
+/* yuv2planeX_10_c_template (output.c): 9/10/12/14-bit vertical plane scaling.
+ *   val = (1 << (shift-1)) + sum_j src[j][i] * filter[j]
+ *   dest[i] = clip_uintp2(val >> shift, bits) << (16 - bits)   (BE/LE store)
+ * shift = 11 + 16 - bits
+ * a0=filter(int16*), a1=filterSize, a2=src(int16**), a3=dest,
+ * a4=dstW, a5=dither(unused), a6=offset(unused)
+ */
+
+.macro yuv2planeX_rvv depth, bits, isbe
+func ff_yuv2planeX_\depth\()_rvv, zve32x
+        lpad    0
+        addi    sp, sp, -24
+        sd      s0, 0(sp)
+        sd      s1, 8(sp)
+        sd      s2, 16(sp)
+        mv      s0, a0                  /* filter base */
+        li      t0, 1
+        slli    t0, t0, (11 + 16 - \bits - 1)   /* 1 << (shift-1) */
+        mv      s1, t0
+        li      t1, \bits - 1
+        li      t2, (1 << \bits) - 1    /* clip mask */
+        /* per VL slice */
+1:      beqz    a4, 3f
+        vsetvli s2, a4, e16, m2, ta, ma /* vl -> s2 */
+        vsetvli zero, zero, e32, m4, ta, ma
+        vmv.v.i v16, 0
+        vmv.v.i v17, 0
+        vmv.v.x v18, s1
+        vmv.v.x v19, s1
+        vadd.vv v16, v16, v18          /* init val (e32) */
+        vadd.vv v17, v17, v19
+        vsetvli zero, zero, e16, m2, ta, ma
+        mv      t3, a2                  /* src array */
+        li      t4, 0                   /* j */
+        li      t6, 0                   /* column byte offset */
+2:      ld      t5, 0(t3)
+        add     t5, t5, t6              /* src[j] + column offset */
+        vle16.v v0, (t5)
+        slli    t5, t4, 1
+        add     t5, s0, t5
+        lh      t5, 0(t5)               /* filter[j] */
+        vwmacc.vx v16, t5, v0
+        addi    t3, t3, 8
+        addi    t4, t4, 1
+        blt     t4, a1, 2b
+        /* val >> shift */
+        li      t5, 11 + 16 - \bits
+        vsetvli zero, zero, e32, m4, ta, ma
+        vsra.vx v16, v16, t5
+        /* clip [0, 2^bits-1] */
+        vmax.vx v16, v16, zero
+        li      t5, (1 << \bits) - 1
+        vmin.vx v16, v16, t5
+        /* << (16 - bits) */
+        li      t5, 16 - \bits
+        vsll.vx v16, v16, t5
+        /* narrow to e16 */
+        vsetvli zero, zero, e32, m4, ta, ma
+        vnsrl.wi v8, v16, 0
+        vsetvli zero, zero, e16, m2, ta, ma
+    .if \isbe
+        /* byte-swap each e16: (v>>8)|(v<<8) */
+        vsrl.vi v9, v8, 8
+        vsll.vi v10, v8, 8
+        vor.vv  v8, v9, v10
+    .endif
+        vse16.v v8, (a3)
+        slli    t1, s2, 1
+        add     t6, t6, t1              /* column offset += vl*2 */
+        add     a3, a3, t1              /* dest += vl*2 */
+        sub     a4, a4, s2              /* width -= vl */
+        bnez    a4, 1b
+3:      ld      s0, 0(sp)
+        ld      s1, 8(sp)
+        ld      s2, 16(sp)
+        addi    sp, sp, 24
+        ret
+endfunc
+.endm
+
+yuv2planeX_rvv 9LE,  9,  0
+yuv2planeX_rvv 9BE,  9,  1
+yuv2planeX_rvv 10LE, 10, 0
+yuv2planeX_rvv 10BE, 10, 1
+yuv2planeX_rvv 12LE, 12, 0
+yuv2planeX_rvv 12BE, 12, 1
+yuv2planeX_rvv 14LE, 14, 0
+yuv2planeX_rvv 14BE, 14, 1
+
+/* yuv2nv12cX_c (8-bit): u/v dual-plane filter + interleaved output.
+ * a0=dstFormat, a1=chrDither, a2=chrFilter, a3=chrFilterSize,
+ * a4=chrUSrc(int16**), a5=chrVSrc(int16**), a6=dest, a7=chrDstW
+ * Scalar loop (simple, correct).
+ */
+func ff_yuv2nv12cX_8_rvv, zve32x
+        lpad    0
+        addi    sp, sp, -32
+        sd      s0, 0(sp)
+        sd      s1, 8(sp)
+        sd      s2, 16(sp)
+        sd      s3, 24(sp)
+        li      t0, 29                   /* NV21 */
+        beq     a0, t0, 4f
+        mv      s0, a4
+        mv      s1, a5
+        j       5f
+4:      mv      s0, a5
+        mv      s1, a4
+5:      li      t0, 0                    /* i */
+1:      beq     t0, a7, 3f
+        andi    t1, t0, 7
+        add     t1, t1, a1
+        lbu     t2, 0(t1)                /* dither[i&7] */
+        slli    t2, t2, 12
+        addi    t1, t0, 3
+        andi    t1, t1, 7
+        add     t1, t1, a1
+        lbu     t3, 0(t1)                /* dither[(i+3)&7] */
+        slli    t3, t3, 12
+        mv      t4, s0
+        mv      t5, s1
+        li      t6, 0                    /* j */
+        li      s2, 0                    /* filter byte offset */
+2:      ld      t1, 0(t4)
+        add     t1, t1, t0
+        add     t1, t1, t0
+        lh      t1, 0(t1)                /* u[j][i] */
+        add     s3, s2, a2
+        lh      s3, 0(s3)                /* filter[j] */
+        mul     t1, t1, s3
+        add     t2, t2, t1
+        ld      t1, 0(t5)
+        add     t1, t1, t0
+        add     t1, t1, t0
+        lh      t1, 0(t1)                /* v[j][i] */
+        add     s3, s2, a2
+        lh      s3, 0(s3)                /* filter[j] */
+        mul     t1, t1, s3
+        add     t3, t3, t1
+        addi    t4, t4, 8
+        addi    t5, t5, 8
+        addi    t6, t6, 1
+        addi    s2, s2, 2
+        blt     t6, a3, 2b
+        srai    t2, t2, 19
+        srai    t3, t3, 19
+        li      t1, 255
+        bltz    t2, 9f
+        bgt     t2, t1, 8f
+        j       10f
+8:      mv      t2, t1
+        j       10f
+9:      li      t2, 0
+10:     bltz    t3, 11f
+        bgt     t3, t1, 13f
+        j       12f
+13:     mv      t3, t1
+        j       12f
+11:     li      t3, 0
+12:     sb      t2, 0(a6)
+        sb      t3, 1(a6)
+        addi    a6, a6, 2
+        addi    t0, t0, 1
+        j       1b
+3:      ld      s0, 0(sp)
+        ld      s1, 8(sp)
+        ld      s2, 16(sp)
+        ld      s3, 24(sp)
+        addi    sp, sp, 32
+        ret
+endfunc
