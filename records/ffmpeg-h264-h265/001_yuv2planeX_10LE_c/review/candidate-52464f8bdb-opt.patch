 av_cold void ff_sws_init_swscale_riscv(SwsInternal *c)
 {
 #if HAVE_RVV
     int flags = av_get_cpu_flags();
+#if __riscv_xlen == 64
+    const enum AVPixelFormat format = c->opts.dst_format;
+    if ((flags & AV_CPU_FLAG_RVV_I32) && ff_rv_vlen_least(128)) {
+        if (isNBPS(format) && !isSemiPlanarYUV(format) && !isDataInHighBits(format)) {
+            switch (av_pix_fmt_desc_get(format)->comp[0].depth) {
+            case 9: c->yuv2planeX = isBE(format) ? ff_yuv2planeX_9BE_rvv : ff_yuv2planeX_9LE_rvv; break;
+            case 10: c->yuv2planeX = isBE(format) ? ff_yuv2planeX_10BE_rvv : ff_yuv2planeX_10LE_rvv; break;
+            case 12: c->yuv2planeX = isBE(format) ? ff_yuv2planeX_12BE_rvv : ff_yuv2planeX_12LE_rvv; break;
+            case 14: c->yuv2planeX = isBE(format) ? ff_yuv2planeX_14BE_rvv : ff_yuv2planeX_14LE_rvv; break;
+            }
+        }
+        if (format == AV_PIX_FMT_NV12) c->yuv2nv12cX = ff_yuv2nv12cX_8_rvv;
+        if (format == AV_PIX_FMT_NV21) c->yuv2nv12cX = ff_yuv2nv21cX_8_rvv;
+    }
+#endif
+
 
     if ((flags & AV_CPU_FLAG_RVV_I32) && (flags & AV_CPU_FLAG_RVB)) {
         switch (c->opts.src_format) {
