+// Bounded increasing spin-wait for the attention producer/consumer flags.
+//
+// The previous loop yielded (sched_yield) on every poll iteration, which turns
+// a short wait into a syscall storm and keeps the producer's flag cache line
+// bouncing between harts.  Poll instead with a Zihintpause hint for a growing
+// number of iterations and only hand the hart back to the scheduler once the
+// backoff saturates.  The flag itself is still read as a plain volatile load
+// followed by an acquire fence, and the producer still publishes with a release
+// fence, so the synchronization protocol is unchanged.
+template <typename Poll>
+FORCE_INLINE void bounded_spin_wait(Poll&& done) {
+  constexpr uint32_t kMaxSpinDelay = 1024;
+  uint32_t delay = 1;
+  while (!done()) {
+    for (uint32_t i = 0; i < delay; ++i) {
+      CPU_ATTN_SPIN_PAUSE();
+    }
+    if (delay < kMaxSpinDelay) {
+      delay <<= 1;
+    } else {
+      std::this_thread::yield();
+    }
+  }
+}
