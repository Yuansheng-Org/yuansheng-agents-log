+// Bounded spin-wait pause hint used by the attention producer/consumer flag
+// polling.  Prefer the architecture FAST_SPINNING hint when the build declares
+// it.  On RISC-V, FAST_SPINNING is only defined when the toolchain advertises
+// Zihintpause, so emit `pause` directly otherwise: Zihintpause encodes `pause`
+// as `fence w, 0`, which is a HINT and executes as a no-op on cores that do not
+// implement the extension, so it never traps.  Targets without a hint expand to
+// nothing and rely on the backoff plus the scheduler yield.
+#ifndef CPU_ATTN_SPIN_PAUSE
+  #ifdef FAST_SPINNING
+    #define CPU_ATTN_SPIN_PAUSE() FAST_SPINNING
+  #elif defined(__riscv) || defined(__riscv__)
+    #define CPU_ATTN_SPIN_PAUSE() __asm__ __volatile__(".word 0x0100000f")
+  #else
+    #define CPU_ATTN_SPIN_PAUSE() ((void)0)
+  #endif
+#endif
+
 #endif
