-// Universal Intrinsics; the dispatched backend selects RVV.
+// dim=0, REDUCE_SUM2 for CV_32F using scalable universal intrinsics.
 static void reduceRowSum2_32f32f(const Mat& srcmat, Mat& dstmat)
