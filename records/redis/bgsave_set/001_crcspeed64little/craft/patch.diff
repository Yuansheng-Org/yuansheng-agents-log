diff --git a/src/crcspeed.c b/src/crcspeed.c
index cfc58109f..fea4bc7ae 100644
--- a/src/crcspeed.c
+++ b/src/crcspeed.c
@@ -40,6 +40,178 @@
 #include "crcspeed.h"
 #include "crccombine.h"
 
+/* ---------------------------------------------------------------------------
+ * RISC-V Zbc (carry-less multiply) accelerated CRC-64/GO-ISO path.
+ *
+ * CRC-64 is GF(2^64) polynomial division; the slice-by-8 table path below
+ * simulates the binary-field products with a 16KB lookup table.  On RISC-V
+ * cores exposing the Zbc extension the hardware clmul/clmulh instructions
+ * compute the same carry-less products directly.  The Zbc path is selected at
+ * runtime via the riscv_hwprobe syscall, so the binary stays portable: cores
+ * without Zbc keep using the lookup-table path.
+ *
+ * Folding structure (reflected bit order, 16 bytes per iteration, data loaded
+ * little-endian as-is, state kept as the 128-bit (high:low) pair):
+ *
+ *   low  = data[0] ^ crc;  high = data[1]
+ *   loop: t0 = clmul(low, K3);  t1 = clmulh(low, K3)
+ *         t2 = clmul(high, K4); t3 = clmulh(high, K4)
+ *         low  = (t0 ^ t2) ^ next0
+ *         high = (t1 ^ t3) ^ next1
+ *   then a Barrett-style reduction folds the 128-bit state to 64 bits.
+ *
+ * The constants are derived from the reflected CRC-64/GO-ISO polynomial
+ * P(x) = x^64 + 0xad93d23594c935a9 (RefIn=RefOut=true):
+ *
+ *   K3 = 2 * rev64(x^192 mod P)      K4 = 2 * rev64(x^128 mod P)
+ *   K5 = 2 * rev64(x^64  mod P)      K6 = rev65(x^128 div P)
+ *   PF = (rev64(P) << 1) | 1
+ *
+ * where rev64/rev65 are full bit-reversals.  K5 and PF carry an implicit
+ * 2^64 term (bit 64 set), which is handled via the 64-bit split forms used in
+ * the reduction below.  This path is verified bit-exact against the table
+ * implementation, including the KAT vectors
+ * crc64(0, "123456789") = e9c6d914c4b8d9ca and the Lorem-ipsum vector
+ * c7794709e69683b3.
+ * ------------------------------------------------------------------------- */
+#if defined(__riscv) && defined(__linux__)
+#include <sys/syscall.h>
+#include <unistd.h>
+
+#if defined(__has_include)
+# if __has_include(<asm/hwprobe.h>)
+#  include <asm/hwprobe.h>
+# endif
+#endif
+
+#ifndef __NR_riscv_hwprobe
+#define __NR_riscv_hwprobe 258
+#endif
+#ifndef RISCV_HWPROBE_KEY_IMA_EXT_0
+#define RISCV_HWPROBE_KEY_IMA_EXT_0 4
+/* Fallback definition used when <asm/hwprobe.h> is unavailable; matches the
+ * kernel UAPI layout (long is 64-bit on rv64). */
+struct riscv_hwprobe { long key; unsigned long value; };
+#endif
+#ifndef RISCV_HWPROBE_EXT_ZBC
+#define RISCV_HWPROBE_EXT_ZBC (1ULL << 7)
+#endif
+
+static inline uint64_t crc_zbc_clmul(uint64_t a, uint64_t b) {
+    uint64_t r;
+    /* clmul rd, rs1, rs2: OP, func3=0b001, func7=0b0000101.  The .insn form is
+     * accepted by GNU as regardless of the -march baseline (the extension is
+     * only ever executed on cores confirmed to implement Zbc at runtime). */
+    __asm__ volatile(".insn r 0x33, 0x1, 0x5, %0, %1, %2"
+                     : "=r"(r) : "r"(a), "r"(b));
+    return r;
+}
+
+static inline uint64_t crc_zbc_clmulh(uint64_t a, uint64_t b) {
+    uint64_t r;
+    /* clmulh rd, rs1, rs2: OP, func3=0b011, func7=0b0000101. */
+    __asm__ volatile(".insn r 0x33, 0x3, 0x5, %0, %1, %2"
+                     : "=r"(r) : "r"(a), "r"(b));
+    return r;
+}
+
+/* One-time runtime probe: does this RISC-V core implement Zbc?  Uses the
+ * riscv_hwprobe syscall; if the kernel does not support it the Zbc path is
+ * simply not used (the lookup-table implementation remains active). */
+static int riscv64_has_zbc(void) {
+    static int cached = -1;
+    int detected = 0;
+
+    if (__atomic_load_n(&cached, __ATOMIC_RELAXED) >= 0)
+        return __atomic_load_n(&cached, __ATOMIC_RELAXED);
+
+#if defined(__NR_riscv_hwprobe) && defined(RISCV_HWPROBE_KEY_IMA_EXT_0)
+    {
+        struct riscv_hwprobe probes[] = {{RISCV_HWPROBE_KEY_IMA_EXT_0, 0}};
+        if (syscall(__NR_riscv_hwprobe, probes,
+                    sizeof(probes) / sizeof(probes[0]), 0, NULL, 0) == 0 &&
+            (probes[0].value & RISCV_HWPROBE_EXT_ZBC))
+            detected = 1;
+    }
+#endif
+
+    __atomic_store_n(&cached, detected, __ATOMIC_RELAXED);
+    return detected;
+}
+
+#define CRC64_ZBC_K3 UINT64_C(0xd9d7be7d505da32c)
+#define CRC64_ZBC_K4 UINT64_C(0x381d0015c96f4444)
+#define CRC64_ZBC_K5 UINT64_C(0x2b5926535897936a) /* low 64 of 2^64 | K5 */
+#define CRC64_ZBC_K6 UINT64_C(0x3e6cfa329aef9f77)
+#define CRC64_ZBC_PF UINT64_C(0x2b5926535897936b) /* low 64 of 2^64 | PF */
+
+/* CRC-64/GO-ISO in reflected bit order, 16 bytes per iteration, using Zbc
+ * clmul/clmulh.  The lookup table is only used for the byte-alignment prefix
+ * and the sub-16-byte tail. */
+uint64_t crcspeed64little_zbc(uint64_t table[8][256], uint64_t crc, void *buf,
+                              size_t len) {
+    unsigned char *next = buf;
+    uint64_t low, high, t0, t1, t2, t3;
+    size_t main_len;
+
+    /* process individual bytes until we reach an 8-byte aligned pointer */
+    while (len && ((uintptr_t)next & 7) != 0) {
+        crc = table[0][(crc ^ *next++) & 0xff] ^ (crc >> 8);
+        len--;
+    }
+
+    /* the clmul main loop below processes whole 16-byte blocks only; its
+     * loads stay 8-byte aligned.  Any trailing sub-16-byte bytes are handled
+     * by the lookup-table path afterwards. */
+    main_len = len - (len % 16);
+    if (main_len >= 16) {
+        len -= main_len;    /* len now holds only the trailing tail bytes */
+
+        low = *(uint64_t *)next ^ crc;
+        high = *(uint64_t *)(next + 8);
+        next += 16;
+        main_len -= 16;
+
+        while (main_len >= 16) {
+            t0 = crc_zbc_clmul(low, CRC64_ZBC_K3);
+            t1 = crc_zbc_clmulh(low, CRC64_ZBC_K3);
+            t2 = crc_zbc_clmul(high, CRC64_ZBC_K4);
+            t3 = crc_zbc_clmulh(high, CRC64_ZBC_K4);
+            low = t0 ^ t2 ^ *(uint64_t *)next;
+            high = t1 ^ t3 ^ *(uint64_t *)(next + 8);
+            next += 16;
+            main_len -= 16;
+        }
+
+        /* fold the 128-bit state (high:low) down to a 64-bit value */
+        t2 = crc_zbc_clmul(low, CRC64_ZBC_K4);
+        t3 = crc_zbc_clmulh(low, CRC64_ZBC_K4);
+        low = high ^ t2;
+        high = t3;
+
+        /* Barrett-style reduction:
+         *   reduced = clmul(low, 2^64 | K5) ^ (high << 64)
+         *           = ((low ^ high) << 64) ^ clmul(low, K5)
+         *   barrett = clmul(reduced & MASK64, K6) & MASK64
+         *   result  = clmulh(barrett, 2^64 | PF) ^ barrett ^ reduced_hi
+         *           = clmulh(barrett, PF) ^ barrett ^ reduced_hi
+         */
+        t0 = crc_zbc_clmul(low, CRC64_ZBC_K5); /* reduced low 64 */
+        t1 = crc_zbc_clmulh(low, CRC64_ZBC_K5) ^ low ^ high; /* reduced high 64 */
+        t2 = crc_zbc_clmul(t0, CRC64_ZBC_K6);  /* barrett */
+        crc = crc_zbc_clmulh(t2, CRC64_ZBC_PF) ^ t2 ^ t1;
+    }
+
+    /* process the trailing bytes (fewer than 16) with the table path */
+    while (len) {
+        crc = table[0][(crc ^ *next++) & 0xff] ^ (crc >> 8);
+        len--;
+    }
+
+    return crc;
+}
+#endif /* __riscv && __linux__ */
+
 #define CRC64_LEN_MASK UINT64_C(0x7ffffffffffffff8)
 #define CRC64_REVERSED_POLY UINT64_C(0x95ac9329ac4bc9b5)
 
@@ -377,11 +549,18 @@ uint16_t crcspeed16big(uint16_t big_table[8][256], uint16_t crc_in, void *buf,
 /* Return the CRC of buf[0..len-1] with initial crc, processing eight bytes
    at a time using passed-in lookup table.
    This selects one of two routines depending on the endianness of
-   the architecture. */
+   the architecture. On RISC-V (little-endian) with the Zbc extension the
+   hardware carry-less multiply path is selected at runtime instead. */
 uint64_t crcspeed64native(uint64_t table[8][256], uint64_t crc, void *buf,
                           size_t len) {
     uint64_t n = 1;
 
+#if defined(__riscv) && defined(__linux__)
+    /* RISC-V is little-endian by ABI; the endianness check below documents
+     * that the Zbc path implements the little-endian reflected CRC. */
+    if (riscv64_has_zbc() && *(char *)&n)
+        return crcspeed64little_zbc(table, crc, buf, len);
+#endif
     return *(char *)&n ? crcspeed64little(table, crc, buf, len)
                        : crcspeed64big(table, crc, buf, len);
 }
