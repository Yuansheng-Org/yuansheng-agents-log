+template <bool calculate_variance>
+const jit_uni_batch_normalization_fwd_stat_kernel_t &
+get_jit_batch_normalization_fwd_stat_kernel() {
+    static const jit_uni_batch_normalization_fwd_stat_kernel_t kernel(
+            calculate_variance);
+    return kernel;
