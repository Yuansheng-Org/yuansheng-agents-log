+const jit_rvv_softmax_f16_strided_kernel_t &
+get_jit_rvv_softmax_f16_strided_kernel(bool gather) {
+    static const jit_rvv_softmax_f16_strided_kernel_t kernel_gather(true);
+    static const jit_rvv_softmax_f16_strided_kernel_t kernel_scatter(false);
+    return gather ? kernel_gather : kernel_scatter;
