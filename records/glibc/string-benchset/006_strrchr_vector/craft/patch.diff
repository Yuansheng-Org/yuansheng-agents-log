diff --git a/sysdeps/riscv/rvv/strrchr.S b/sysdeps/riscv/rvv/strrchr.S
index f2da8a4b23..daa58fdc03 100644
--- a/sysdeps/riscv/rvv/strrchr.S
+++ b/sysdeps/riscv/rvv/strrchr.S
@@ -54,8 +54,16 @@ ENTRY (STRRCHR)
 L(loop):
     mv blk_base, str
 
-    vsetvli cur_vl, zero, e8, m2, ta, ma
-    vle8ff.v vstr, (str)
+    /* Bound the load to the remaining bytes of the current page
+       (4 KiB is a sub-multiple of every real RISC-V page size, so this
+       never crosses a real page boundary).  The advance then uses the
+       register value of vl directly, removing the per-iteration csrr.  */
+    li t0, -4096
+    and t0, t0, str
+    sub t0, t0, str
+    neg t0, t0
+    vsetvli cur_vl, t0, e8, m2, ta, ma
+    vle8.v vstr, (str)
 
     vmseq.vi vmask_end, vstr, 0
     vmsbf.m vvalid, vmask_end
@@ -63,10 +71,10 @@ L(loop):
     vmand.mm vhit, vmask_ch, vvalid
 
     vfirst.m first_idx, vhit
-    csrr cur_vl, vl
     bltz first_idx, L(no_hit_in_block)
 
-    vsetvli zero, cur_vl, e16, m4, ta, ma
+    /* Keep a single e8/m2 vtype: compute the per-block last hit index
+       with vid.v + masked vredmaxu in the same vtype as the scan.  */
     vid.v vidx
     vmv.s.x vacc, x0
     /* Compute per-block last hit index (or -1 if none). */
@@ -78,7 +86,6 @@ L(no_hit_in_block):
     li loc_max, -1
 
 L(loc_max_ready):
-    vsetvli zero, cur_vl, e8, m2, ta, ma
     vcpop.m len_valid, vvalid
 
     bne len_valid, cur_vl, L(tail_block)
