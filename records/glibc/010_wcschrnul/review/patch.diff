diff --git a/sysdeps/riscv/rvv/wcschrnul.S b/sysdeps/riscv/rvv/wcschrnul.S
new file mode 100644
index 00000000..e54b950d
--- /dev/null
+++ b/sysdeps/riscv/rvv/wcschrnul.S
@@ -0,0 +1,54 @@
+/* RISC-V RVV based wcschrnul.
+   Copyright (C) 2026 Free Software Foundation, Inc.
+   This file is part of the GNU C Library.
+   Licensed under the GNU Lesser General Public License v2.1+; see COPYING.LESSER.  */
+
+#include <sysdep.h>
+#include <sys/asm.h>
+
+#ifndef WCSCHRNUL
+# define WCSCHRNUL __wcschrnul
+#endif
+
+#define wcs a0
+#define wc a1
+#define first_wchar t0
+#define vl_reg a3
+#define first a5
+#define post_vl a6
+
+#define vchunk v16
+#define vhit v0
+#define vtmp v1
+
+ENTRY (WCSCHRNUL)
+.option push
+.option arch, +v
+	/* Avoid vector startup and loop-control costs for positions 0 through 4.  */
+	.rept	5
+	lw	first_wchar, 0(wcs)
+	beq	first_wchar, wc, L(found_scalar)
+	beqz	first_wchar, L(found_scalar)
+	addi	wcs, wcs, 4
+	.endr
+
+L(loop):
+	vsetvli	vl_reg, zero, e32, m8, ta, ma
+	vle32ff.v	vchunk, (wcs)
+	vmseq.vx	vtmp, vchunk, wc
+	vmseq.vi	vhit, vchunk, 0
+	vmor.mm	vhit, vhit, vtmp
+	vfirst.m	first, vhit
+	bgez	first, L(found)
+	csrr	post_vl, vl
+	slli	post_vl, post_vl, 2
+	add	wcs, wcs, post_vl
+	j	L(loop)
+L(found_scalar):
+	ret
+L(found):
+	slli	first, first, 2
+	add	a0, wcs, first
+	ret
+.option pop
+END (WCSCHRNUL)
diff --git a/sysdeps/unix/sysv/linux/riscv/multiarch/Makefile b/sysdeps/unix/sysv/linux/riscv/multiarch/Makefile
index bdbd12a2..5f65a615 100644
--- a/sysdeps/unix/sysv/linux/riscv/multiarch/Makefile
+++ b/sysdeps/unix/sysv/linux/riscv/multiarch/Makefile
@@ -59,3 +59,11 @@ CFLAGS-strlen-generic.op = $(no-stack-protector)
 
 CFLAGS-memcpy_noalignment.c += -mno-strict-align
 endif
+
+ifeq ($(subdir),wcsmbs)
+sysdep_routines += \
+  wcschrnul \
+  wcschrnul-generic \
+  wcschrnul-vector \
+  # sysdep_routines
+endif
diff --git a/sysdeps/unix/sysv/linux/riscv/multiarch/ifunc-impl-list.c b/sysdeps/unix/sysv/linux/riscv/multiarch/ifunc-impl-list.c
index ac2b25de..a600c2d2 100644
--- a/sysdeps/unix/sysv/linux/riscv/multiarch/ifunc-impl-list.c
+++ b/sysdeps/unix/sysv/linux/riscv/multiarch/ifunc-impl-list.c
@@ -18,6 +18,7 @@
 
 #include <ifunc-impl-list.h>
 #include <string.h>
+#include <wchar.h>
 #include <sys/hwprobe.h>
 
 size_t
@@ -120,5 +121,10 @@ __libc_ifunc_impl_list (const char *name, struct libc_ifunc_impl *array,
 			      __strncpy_vector)
 	      IFUNC_IMPL_ADD (array, i, strncpy, 1, __strncpy_generic))
 
+  IFUNC_IMPL (i, name, wcschrnul,
+	      IFUNC_IMPL_ADD (array, i, wcschrnul, rvv_enabled,
+			      __wcschrnul_vector)
+	      IFUNC_IMPL_ADD (array, i, wcschrnul, 1, __wcschrnul_generic))
+
   return 0;
 }
diff --git a/sysdeps/unix/sysv/linux/riscv/multiarch/wcschrnul.c b/sysdeps/unix/sysv/linux/riscv/multiarch/wcschrnul.c
new file mode 100644
index 00000000..ba5b69df
--- /dev/null
+++ b/sysdeps/unix/sysv/linux/riscv/multiarch/wcschrnul.c
@@ -0,0 +1,44 @@
+/* Multiple versions of wcschrnul.
+   All versions must be listed in ifunc-impl-list.c.
+   Copyright (C) 2026 Free Software Foundation, Inc.
+   This file is part of the GNU C Library.
+   Licensed under the GNU Lesser General Public License v2.1+; see COPYING.LESSER.  */
+
+#if IS_IN (libc)
+# undef wcschrnul
+# define wcschrnul __redirect_wcschrnul
+# include <stdint.h>
+# include <wchar.h>
+# include <ifunc-init.h>
+# include <riscv-ifunc.h>
+# include <sys/hwprobe.h>
+
+extern __typeof (__redirect_wcschrnul) __libc_wcschrnul;
+
+extern __typeof (__redirect_wcschrnul) __wcschrnul_generic attribute_hidden;
+extern __typeof (__redirect_wcschrnul) __wcschrnul_vector attribute_hidden;
+
+static inline __typeof (__redirect_wcschrnul) *
+select_wcschrnul_ifunc (uint64_t dl_hwcap, __riscv_hwprobe_t hwprobe_func)
+{
+  unsigned long long v;
+
+  if (__riscv_hwprobe_one (hwprobe_func, RISCV_HWPROBE_KEY_IMA_EXT_0, &v) == 0
+      && (v & RISCV_HWPROBE_IMA_V) == RISCV_HWPROBE_IMA_V)
+    return __wcschrnul_vector;
+
+  return __wcschrnul_generic;
+}
+
+riscv_libc_ifunc (__libc_wcschrnul, select_wcschrnul_ifunc);
+
+# undef wcschrnul
+strong_alias (__libc_wcschrnul, wcschrnul);
+strong_alias (wcschrnul, __wcschrnul)
+# ifdef SHARED
+__hidden_ver1 (wcschrnul, __GI_wcschrnul, __redirect_wcschrnul)
+  __attribute__ ((visibility ("hidden"))) __attribute_copy__ (wcschrnul);
+# endif
+#else
+# include <wcsmbs/wcschrnul.c>
+#endif
