diff --git a/onnxruntime/core/common/spin_pause.cc b/onnxruntime/core/common/spin_pause.cc
index 6868232ce9..dd30f27e2c 100644
--- a/onnxruntime/core/common/spin_pause.cc
+++ b/onnxruntime/core/common/spin_pause.cc
@@ -54,6 +54,12 @@ void SpinPause() {
   __asm__ __volatile__("yield" ::: "memory");
 #elif defined(__arm__)
   __asm__ __volatile__("yield" ::: "memory");
+#elif defined(__riscv) && defined(__riscv_zihintpause)
+  // RISC-V Zihintpause: emits the standard `pause` hint so the hardware can
+  // reduce issue rate/power on spin loops. This is only a hint and does not
+  // change memory ordering (kept as an asm statement so the optimizer cannot
+  // elide it from the calibration loop).
+  __asm__ __volatile__("pause" ::: "memory");
 #else
   // Generic fallback: a compiler barrier. This prevents the optimizer from
   // collapsing the SpinPause() calls in the calibration loop into nothing.
