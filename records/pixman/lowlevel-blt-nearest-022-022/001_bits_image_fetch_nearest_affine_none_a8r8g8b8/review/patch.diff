From 3c7e6320334258b0fb361b2a691d887d48d3f05f Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?=E7=94=B0=E5=AE=81?= <tianning24@iscas.ac.cn>
Date: Mon, 28 Sep 2026 10:58:54 +0800
Subject: [PATCH] rvv: fix a8r8g8b8 nearest scale fetch

---
 pixman/pixman-fast-path.c |  12 ++++
 pixman/pixman-private.h   |   9 +++
 pixman/pixman-riscv.c     |   5 ++
 pixman/pixman-rvv.c       | 113 ++++++++++++++++++++++++++++++++++++++
 4 files changed, 139 insertions(+)

diff --git a/pixman/pixman-fast-path.c b/pixman/pixman-fast-path.c
index d510cacb..72b80d11 100644
--- a/pixman/pixman-fast-path.c
+++ b/pixman/pixman-fast-path.c
@@ -3032,6 +3032,18 @@ bits_image_fetch_nearest_affine (pixman_image_t * image,
     x = v.vector[0];
     y = v.vector[1];
 
+#ifdef USE_RVV
+    if (!mask && width > 32 && format == PIXMAN_a8r8g8b8 &&
+	repeat_mode == PIXMAN_REPEAT_NONE &&
+	image->common.transform->matrix[0][1] == 0 &&
+	image->common.transform->matrix[1][0] == 0 && _pixman_have_rvv)
+    {
+	_pixman_rvv_bits_image_fetch_nearest_affine_none_8888 (
+	    image, offset, line, width, buffer, mask);
+	return;
+    }
+#endif
+
     for (i = 0; i < width; ++i)
     {
 	int width, height, x0, y0;
diff --git a/pixman/pixman-private.h b/pixman/pixman-private.h
index 89378def..0af50bdb 100644
--- a/pixman/pixman-private.h
+++ b/pixman/pixman-private.h
@@ -668,6 +668,15 @@ _pixman_implementation_create_power9 (pixman_implementation_t *fallback);
 #ifdef USE_RVV
 pixman_implementation_t *
 _pixman_implementation_create_rvv (pixman_implementation_t *fallback);
+
+/* RISC-V RVV source-fetch hook. _pixman_have_rvv is set to TRUE once the RVV
+   implementation has been created (runtime CPU detection passed). */
+extern pixman_bool_t _pixman_have_rvv;
+
+uint32_t *
+_pixman_rvv_bits_image_fetch_nearest_affine_none_8888 (
+    pixman_image_t *image, int offset, int line, int width,
+    uint32_t *buffer, const uint32_t *mask);
 #endif
 
 pixman_bool_t
diff --git a/pixman/pixman-riscv.c b/pixman/pixman-riscv.c
index 3a5604e7..b7916eff 100644
--- a/pixman/pixman-riscv.c
+++ b/pixman/pixman-riscv.c
@@ -119,6 +119,10 @@ detect_cpu_features (void)
 
 #endif
 
+/* Set to TRUE once the RVV implementation is created (runtime CPU detection
+   passed), signalling that vectorized source-fetch kernels are safe to use. */
+pixman_bool_t _pixman_have_rvv = FALSE;
+
 pixman_implementation_t *
 _pixman_riscv_get_implementations (pixman_implementation_t *imp)
 {
@@ -126,6 +130,7 @@ _pixman_riscv_get_implementations (pixman_implementation_t *imp)
     if (!_pixman_disabled ("rvv") && (detect_cpu_features () & RVV))
     {
 	imp = _pixman_implementation_create_rvv (imp);
+	_pixman_have_rvv = TRUE;
     }
 #endif
     return imp;
diff --git a/pixman/pixman-rvv.c b/pixman/pixman-rvv.c
index 570799ca..ea558b92 100644
--- a/pixman/pixman-rvv.c
+++ b/pixman/pixman-rvv.c
@@ -3092,6 +3092,119 @@ static const pixman_fast_path_t rvv_fast_paths[] = {
     {PIXMAN_OP_NONE},
 };
 
+/* Nearest scale NONE a8r8g8b8 fetch.
+ *
+ * Replicates bits_image_fetch_nearest_affine for format=a8r8g8b8 and
+ * repeat=PIXMAN_REPEAT_NONE with no mask: the per-pixel source index
+ * (x0,y0) is generated via the exact affine recurrence (int64 expand +
+ * truncate to int32, matching the scalar x += ux wrapping), the in-bounds
+ * check masks the indexed byte-offset loads, and out-of-bounds lanes are
+ * zeroed. Short rows and non-scale affine transforms stay on the scalar path.
+ */
+uint32_t *
+_pixman_rvv_bits_image_fetch_nearest_affine_none_8888 (
+    pixman_image_t *image, int offset, int line, int width,
+    uint32_t *buffer, const uint32_t *mask)
+{
+    bits_image_t *bits = &image->bits;
+    const uint32_t *base = bits->bits;
+    int rowstride = bits->rowstride;
+    pixman_bool_t flipped = rowstride < 0;
+    pixman_bool_t narrow_offsets;
+    pixman_fixed_t x, y, ux, uy;
+    pixman_vector_t v;
+    int i;
+
+    v.vector[0] = pixman_int_to_fixed (offset) + pixman_fixed_1 / 2;
+    v.vector[1] = pixman_int_to_fixed (line) + pixman_fixed_1 / 2;
+    v.vector[2] = pixman_fixed_1;
+
+    if (!pixman_transform_point_3d (image->common.transform, &v))
+	return buffer;
+
+    ux = image->common.transform->matrix[0][0];
+    uy = image->common.transform->matrix[1][0];
+    x = v.vector[0];
+    y = v.vector[1];
+
+    /* Indexed loads use unsigned byte offsets.  For a negative stride,
+     * move the base to the lowest address and mirror logical row indexes. */
+    if (flipped)
+    {
+	base += (int64_t)(bits->height - 1) * rowstride;
+	rowstride = -rowstride;
+    }
+
+    narrow_offsets =
+	(uint64_t)(bits->height - 1) * (uint32_t)rowstride +
+		(uint32_t)(bits->width - 1) <=
+	    UINT32_MAX / sizeof (uint32_t);
+
+    for (i = 0; i < width;)
+    {
+	size_t vl = __riscv_vsetvl_e32m2 ((size_t)(width - i));
+	vuint32m2_t zero = __riscv_vmv_v_x_u32m2 (0, vl);
+	vint32m2_t lane = __riscv_vreinterpret_v_u32m2_i32m2 (
+	    __riscv_vid_v_u32m2 (vl));
+	vint32m2_t xv = __riscv_vadd_vx_i32m2 (
+	    __riscv_vmul_vx_i32m2 (lane, ux, vl), x, vl);
+	vint32m2_t yv = __riscv_vadd_vx_i32m2 (
+	    __riscv_vmul_vx_i32m2 (lane, uy, vl), y, vl);
+	vint32m2_t xi = __riscv_vsra_vx_i32m2 (
+	    __riscv_vsub_vx_i32m2 (xv, pixman_fixed_e, vl), 16, vl);
+	vint32m2_t yi = __riscv_vsra_vx_i32m2 (
+	    __riscv_vsub_vx_i32m2 (yv, pixman_fixed_e, vl), 16, vl);
+	vbool16_t xok = __riscv_vmsltu_vx_u32m2_b16 (
+	    __riscv_vreinterpret_v_i32m2_u32m2 (xi), bits->width, vl);
+	vbool16_t yok = __riscv_vmsltu_vx_u32m2_b16 (
+	    __riscv_vreinterpret_v_i32m2_u32m2 (yi), bits->height, vl);
+	vbool16_t inb = __riscv_vmand_mm_b16 (xok, yok, vl);
+	vint32m2_t yindex = flipped
+	    ? __riscv_vrsub_vx_i32m2 (yi, bits->height - 1, vl) : yi;
+	vuint32m2_t out;
+
+	if (narrow_offsets)
+	{
+	    vint32m2_t index = __riscv_vadd_vv_i32m2 (
+		__riscv_vmul_vx_i32m2 (yindex, rowstride, vl), xi, vl);
+	    vuint32m2_t byte_offset = __riscv_vsll_vx_u32m2 (
+		__riscv_vreinterpret_v_i32m2_u32m2 (index), 2, vl);
+
+	    out = __riscv_vluxei32_v_u32m2_mu (
+		inb, zero, base, byte_offset, vl);
+	}
+	else
+	{
+	    vint64m4_t index = __riscv_vadd_vv_i64m4 (
+		__riscv_vmul_vx_i64m4 (
+		    __riscv_vwcvt_x_x_v_i64m4 (yindex, vl), rowstride, vl),
+		__riscv_vwcvt_x_x_v_i64m4 (xi, vl), vl);
+	    vuint64m4_t byte_offset = __riscv_vsll_vx_u64m4 (
+		__riscv_vreinterpret_v_i64m4_u64m4 (index), 2, vl);
+
+	    out = __riscv_vluxei64_v_u32m2_mu (
+		inb, zero, base, byte_offset, vl);
+	}
+
+	if (mask)
+	{
+	    vbool16_t store = __riscv_vmsne_vx_u32m2_b16 (
+		__riscv_vle32_v_u32m2 (mask + i, vl), 0, vl);
+	    __riscv_vse32_v_u32m2_m (store, buffer + i, out, vl);
+	}
+	else
+	{
+	    __riscv_vse32_v_u32m2 (buffer + i, out, vl);
+	}
+
+	i += vl;
+	x = (pixman_fixed_t)((int64_t)x + (int64_t)vl * ux);
+	y = (pixman_fixed_t)((int64_t)y + (int64_t)vl * uy);
+    }
+
+    return buffer;
+}
+
 pixman_implementation_t *
 _pixman_implementation_create_rvv (pixman_implementation_t *fallback)
 {
-- 
