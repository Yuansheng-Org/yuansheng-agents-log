diff --git a/pixman/pixman-rvv.c b/pixman/pixman-rvv.c
index 570799c..7a4bcbb 100644
--- a/pixman/pixman-rvv.c
+++ b/pixman/pixman-rvv.c
@@ -3092,6 +3092,104 @@ static const pixman_fast_path_t rvv_fast_paths[] = {
