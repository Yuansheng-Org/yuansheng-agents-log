 };
 
+/* Nearest-affine none 8888 fetch, vectorized (degraded verification).
+ *
+ * Replicates bits_image_fetch_nearest_affine for format=a8r8g8b8 and
+ * repeat=PIXMAN_REPEAT_NONE with no mask: the per-pixel source index
+ * (x0,y0) is generated via the exact affine recurrence (int64 expand +
+ * truncate to int32, matching the scalar x += ux wrapping), the in-bounds
+ * check is a mask, the 2-D gather uses vluxei64, and out-of-bounds lanes are
+ * zeroed. The scalar tail preserves the remaining pixels.
+ */
+uint32_t *
+_pixman_rvv_bits_image_fetch_nearest_affine_none_8888 (
+    pixman_image_t *image, int offset, int line, int width,
+    uint32_t *buffer, const uint32_t *mask)
+{
+    bits_image_t *bits = &image->bits;
+    pixman_fixed_t x, y, ux, uy;
+    pixman_vector_t v;
+    const size_t vlmax = __riscv_vsetvlmax_e32m4 ();
+    size_t n = (size_t)width;
+    uint32_t *dst = buffer;
+
+    v.vector[0] = pixman_int_to_fixed (offset) + pixman_fixed_1 / 2;
+    v.vector[1] = pixman_int_to_fixed (line) + pixman_fixed_1 / 2;
+    v.vector[2] = pixman_fixed_1;
+
+    if (!pixman_transform_point_3d (image->common.transform, &v))
+	return buffer;
+
+    ux = image->common.transform->matrix[0][0];
+    uy = image->common.transform->matrix[1][0];
+    x = v.vector[0];
+    y = v.vector[1];
+
+    while (n >= vlmax)
+    {
+	size_t vl = vlmax;
+	vuint32m4_t iu = __riscv_vid_v_u32m4 (vl);
+	vint32m4_t iv = __riscv_vreinterpret_v_u32m4_i32m4 (iu);
+	vint32m4_t x0, y0;
+	vbool8_t ok;
+	vuint64m8_t addru;
+	vuint32m4_t px, zero, out;
+
+	x0 = __riscv_vsra_vx_i32m4 (
+	    __riscv_vsub_vx_i32m4 (
+		__riscv_vncvt_x_x_w_i32m4 (
+		    __riscv_vwadd_wx_i64m8 (
+			__riscv_vwmul_vx_i64m8 (iv, ux, vl), x, vl), vl),
+		1, vl), 16, vl);
+	y0 = __riscv_vsra_vx_i32m4 (
+	    __riscv_vsub_vx_i32m4 (
+		__riscv_vncvt_x_x_w_i32m4 (
+		    __riscv_vwadd_wx_i64m8 (
+			__riscv_vwmul_vx_i64m8 (iv, uy, vl), y, vl), vl),
+		1, vl), 16, vl);
+
+	ok = __riscv_vmand_mm_b8 (
+	    __riscv_vmand_mm_b8 (
+		__riscv_vmsle_vx_i32m4_b8 (x0, bits->width - 1, vl),
+		__riscv_vmsge_vx_i32m4_b8 (x0, 0, vl), vl),
+	    __riscv_vmand_mm_b8 (
+		__riscv_vmsle_vx_i32m4_b8 (y0, bits->height - 1, vl),
+		__riscv_vmsge_vx_i32m4_b8 (y0, 0, vl), vl), vl);
+
+	addru = __riscv_vreinterpret_v_i64m8_u64m8 (
+	    __riscv_vadd_vv_i64m8 (
+		__riscv_vwmul_vv_i64m8 (
+		    y0, __riscv_vmv_v_x_i32m4 (bits->rowstride, vl), vl),
+		__riscv_vwcvt_x_x_v_i64m8 (x0, vl), vl));
+
+	px = __riscv_vluxei64_v_u32m4 (bits->bits, addru, vl);
+	zero = __riscv_vmv_v_x_u32m4 (0, vl);
+	out = __riscv_vmerge_vvm_u32m4 (px, zero, ok, vl);
+	__riscv_vse32_v_u32m4 (dst, out, vl);
+
+	x = (pixman_fixed_t)((int64_t)x + (int64_t)vl * ux);
+	y = (pixman_fixed_t)((int64_t)y + (int64_t)vl * uy);
+	dst += vl;
+	n -= vl;
+    }
+
+    while (n-- > 0)
+    {
+	int x0 = pixman_fixed_to_int (x - pixman_fixed_e);
+	int y0 = pixman_fixed_to_int (y - pixman_fixed_e);
+
+	if (y0 < 0 || y0 >= bits->height || x0 < 0 || x0 >= bits->width)
+	    *dst = 0;
+	else
+	    *dst = *(((uint32_t *)(bits->bits + bits->rowstride * y0)) + x0);
+	dst++;
+	x += ux;
+	y += uy;
+    }
+
+    return buffer;
+}
+
 pixman_implementation_t *
 _pixman_implementation_create_rvv (pixman_implementation_t *fallback)
 {
