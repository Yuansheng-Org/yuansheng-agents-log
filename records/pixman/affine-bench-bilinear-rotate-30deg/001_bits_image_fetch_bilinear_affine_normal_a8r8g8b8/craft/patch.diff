diff --git a/pixman/pixman-rvv.c b/pixman/pixman-rvv.c
index 570799c..695c910 100644
--- a/pixman/pixman-rvv.c
+++ b/pixman/pixman-rvv.c
@@ -3092,6 +3092,159 @@ static const pixman_fast_path_t rvv_fast_paths[] = {
     {PIXMAN_OP_NONE},
 };
 
+/* Bilinear-affine NORMAL 8888 fetch, vectorized (minimal subset).
+ *
+ * Covers only: format a8r8g8b8, repeat=NORMAL, no mask. The per-pixel
+ * (x1,y1,x2,y2) taps are generated via the affine recurrence, wrapped with
+ * the NORMAL repeat modulo (vrem + mask add), gathered (vluxei64) and blended
+ * with the SWAR bilinear_interpolation (lo/hi 0xff00ff split). A scalar tail
+ * replicates the scalar body for the remaining pixels.
+ */
+uint32_t *
+_pixman_rvv_bits_image_fetch_bilinear_affine_normal_8888 (
+    pixman_image_t *image, int offset, int line, int width,
+    uint32_t *buffer, const uint32_t *mask)
+{
+    bits_image_t *bits = &image->bits;
+    pixman_fixed_t x, y, ux, uy;
+    pixman_vector_t v;
+    const size_t vlmax = __riscv_vsetvlmax_e32m4 ();
+    const int32_t W = bits->width, H = bits->height, rs = bits->rowstride;
+    size_t n = (size_t)width;
+    uint32_t *dst = buffer;
+
+    v.vector[0] = pixman_int_to_fixed (offset) + pixman_fixed_1 / 2;
+    v.vector[1] = pixman_int_to_fixed (line) + pixman_fixed_1 / 2;
+    v.vector[2] = pixman_fixed_1;
+    if (!pixman_transform_point_3d (image->common.transform, &v))
+	return buffer;
+    ux = image->common.transform->matrix[0][0];
+    uy = image->common.transform->matrix[1][0];
+    x = v.vector[0];
+    y = v.vector[1];
+
+    while (n >= vlmax)
+    {
+	size_t vl = vlmax;
+	vuint32m4_t iu = __riscv_vid_v_u32m4 (vl);
+	vint32m4_t iv = __riscv_vreinterpret_v_u32m4_i32m4 (iu);
+	vint32m4_t x1, y1, x1i, y1i, x2i, y2i;
+	vint32m4_t dx, dy;
+	vint32m4_t wv = __riscv_vmv_v_x_i32m4 (W, vl);
+	vint32m4_t hv = __riscv_vmv_v_x_i32m4 (H, vl);
+	vint32m4_t rsv = __riscv_vmv_v_x_i32m4 (rs, vl);
+	vbool8_t neg;
+	vuint32m4_t tl, tr, bl, br;
+	vuint32m4_t dxy, dxiy, dixy, dixiy;
+	vuint32m4_t lo, hi, out;
+
+	x1 = __riscv_vncvt_x_x_w_i32m4 (
+	    __riscv_vwadd_wx_i64m8 (__riscv_vwmul_vx_i64m8 (iv, ux, vl), x - 32768, vl), vl);
+	y1 = __riscv_vncvt_x_x_w_i32m4 (
+	    __riscv_vwadd_wx_i64m8 (__riscv_vwmul_vx_i64m8 (iv, uy, vl), y - 32768, vl), vl);
+
+	dx = __riscv_vand_vx_i32m4 (__riscv_vsra_vx_i32m4 (x1, 9, vl), 0x7f, vl);
+	dy = __riscv_vand_vx_i32m4 (__riscv_vsra_vx_i32m4 (y1, 9, vl), 0x7f, vl);
+
+	x1i = __riscv_vsra_vx_i32m4 (x1, 16, vl);
+	y1i = __riscv_vsra_vx_i32m4 (y1, 16, vl);
+	x2i = __riscv_vadd_vx_i32m4 (x1i, 1, vl);
+	y2i = __riscv_vadd_vx_i32m4 (y1i, 1, vl);
+
+	x1i = __riscv_vrem_vv_i32m4 (x1i, wv, vl);
+	x2i = __riscv_vrem_vv_i32m4 (x2i, wv, vl);
+	y1i = __riscv_vrem_vv_i32m4 (y1i, hv, vl);
+	y2i = __riscv_vrem_vv_i32m4 (y2i, hv, vl);
+	neg = __riscv_vmslt_vx_i32m4_b8 (x1i, 0, vl); x1i = __riscv_vadd_vx_i32m4_m (neg, x1i, W, vl);
+	neg = __riscv_vmslt_vx_i32m4_b8 (x2i, 0, vl); x2i = __riscv_vadd_vx_i32m4_m (neg, x2i, W, vl);
+	neg = __riscv_vmslt_vx_i32m4_b8 (y1i, 0, vl); y1i = __riscv_vadd_vx_i32m4_m (neg, y1i, H, vl);
+	neg = __riscv_vmslt_vx_i32m4_b8 (y2i, 0, vl); y2i = __riscv_vadd_vx_i32m4_m (neg, y2i, H, vl);
+
+	tl = __riscv_vluxei64_v_u32m4 (bits->bits,
+	    __riscv_vreinterpret_v_i64m8_u64m8 (__riscv_vadd_vv_i64m8 (
+		__riscv_vwmul_vv_i64m8 (y1i, rsv, vl), __riscv_vwcvt_x_x_v_i64m8 (x1i, vl), vl)), vl);
+	tr = __riscv_vluxei64_v_u32m4 (bits->bits,
+	    __riscv_vreinterpret_v_i64m8_u64m8 (__riscv_vadd_vv_i64m8 (
+		__riscv_vwmul_vv_i64m8 (y1i, rsv, vl), __riscv_vwcvt_x_x_v_i64m8 (x2i, vl), vl)), vl);
+	bl = __riscv_vluxei64_v_u32m4 (bits->bits,
+	    __riscv_vreinterpret_v_i64m8_u64m8 (__riscv_vadd_vv_i64m8 (
+		__riscv_vwmul_vv_i64m8 (y2i, rsv, vl), __riscv_vwcvt_x_x_v_i64m8 (x1i, vl), vl)), vl);
+	br = __riscv_vluxei64_v_u32m4 (bits->bits,
+	    __riscv_vreinterpret_v_i64m8_u64m8 (__riscv_vadd_vv_i64m8 (
+		__riscv_vwmul_vv_i64m8 (y2i, rsv, vl), __riscv_vwcvt_x_x_v_i64m8 (x2i, vl), vl)), vl);
+
+	/* 4-bit weights and the four bilinear weights */
+	{
+	    vuint32m4_t dxu = __riscv_vsrl_vx_u32m4 (
+		__riscv_vreinterpret_v_i32m4_u32m4 (dx), 3, vl);
+	    vuint32m4_t dyu = __riscv_vsrl_vx_u32m4 (
+		__riscv_vreinterpret_v_i32m4_u32m4 (dy), 3, vl);
+	    vuint32m4_t s16 = __riscv_vmv_v_x_u32m4 (16, vl);
+	    vuint32m4_t s256 = __riscv_vmv_v_x_u32m4 (256, vl);
+	    dxy = __riscv_vmul_vv_u32m4 (dxu, dyu, vl);
+	    dxiy = __riscv_vsub_vv_u32m4 (__riscv_vsll_vx_u32m4 (dxu, 4, vl), dxy, vl);
+	    dixy = __riscv_vsub_vv_u32m4 (__riscv_vsll_vx_u32m4 (dyu, 4, vl), dxy, vl);
+	    dixiy = __riscv_vadd_vv_u32m4 (
+		__riscv_vsub_vv_u32m4 (__riscv_vsub_vv_u32m4 (
+		    s256, __riscv_vsll_vx_u32m4 (dyu, 4, vl), vl),
+		    __riscv_vsll_vx_u32m4 (dxu, 4, vl), vl), dxy, vl);
+	    (void)s16;
+	}
+
+	/* SWAR lo/hi blend matching bilinear_interpolation */
+	lo = __riscv_vmul_vv_u32m4 (__riscv_vand_vx_u32m4 (tl, 0xff00ff, vl), dixiy, vl);
+	hi = __riscv_vmul_vv_u32m4 (
+	    __riscv_vand_vx_u32m4 (__riscv_vsrl_vx_u32m4 (tl, 8, vl), 0xff00ff, vl), dixiy, vl);
+	lo = __riscv_vadd_vv_u32m4 (lo,
+	    __riscv_vmul_vv_u32m4 (__riscv_vand_vx_u32m4 (tr, 0xff00ff, vl), dxiy, vl), vl);
+	hi = __riscv_vadd_vv_u32m4 (hi,
+	    __riscv_vmul_vv_u32m4 (__riscv_vand_vx_u32m4 (__riscv_vsrl_vx_u32m4 (tr, 8, vl), 0xff00ff, vl), dxiy, vl), vl);
+	lo = __riscv_vadd_vv_u32m4 (lo,
+	    __riscv_vmul_vv_u32m4 (__riscv_vand_vx_u32m4 (bl, 0xff00ff, vl), dixy, vl), vl);
+	hi = __riscv_vadd_vv_u32m4 (hi,
+	    __riscv_vmul_vv_u32m4 (__riscv_vand_vx_u32m4 (__riscv_vsrl_vx_u32m4 (bl, 8, vl), 0xff00ff, vl), dixy, vl), vl);
+	lo = __riscv_vadd_vv_u32m4 (lo,
+	    __riscv_vmul_vv_u32m4 (__riscv_vand_vx_u32m4 (br, 0xff00ff, vl), dxy, vl), vl);
+	hi = __riscv_vadd_vv_u32m4 (hi,
+	    __riscv_vmul_vv_u32m4 (__riscv_vand_vx_u32m4 (__riscv_vsrl_vx_u32m4 (br, 8, vl), 0xff00ff, vl), dxy, vl), vl);
+
+	out = __riscv_vor_vv_u32m4 (
+	    __riscv_vand_vx_u32m4 (__riscv_vsrl_vx_u32m4 (lo, 8, vl), 0xff00ff, vl),
+	    __riscv_vand_vx_u32m4 (hi, 0xff00ff00, vl), vl);
+	__riscv_vse32_v_u32m4 (dst, out, vl);
+
+	x = (pixman_fixed_t)((int64_t)x + (int64_t)vl * ux);
+	y = (pixman_fixed_t)((int64_t)y + (int64_t)vl * uy);
+	dst += vl;
+	n -= vl;
+    }
+
+    while (n-- > 0)
+    {
+	int x1, y1, x2, y2;
+	int32_t distx, disty;
+
+	x1 = x - pixman_fixed_1 / 2;
+	y1 = y - pixman_fixed_1 / 2;
+	distx = pixman_fixed_to_bilinear_weight (x1);
+	disty = pixman_fixed_to_bilinear_weight (y1);
+	y1 = pixman_fixed_to_int (y1); y2 = y1 + 1;
+	x1 = pixman_fixed_to_int (x1); x2 = x1 + 1;
+	repeat (PIXMAN_REPEAT_NORMAL, &x1, W);
+	repeat (PIXMAN_REPEAT_NORMAL, &y1, H);
+	repeat (PIXMAN_REPEAT_NORMAL, &x2, W);
+	repeat (PIXMAN_REPEAT_NORMAL, &y2, H);
+	*dst++ = bilinear_interpolation (
+	    bits->bits[rs * y1 + x1], bits->bits[rs * y1 + x2],
+	    bits->bits[rs * y2 + x1], bits->bits[rs * y2 + x2],
+	    distx, disty);
+	x += ux;
+	y += uy;
+    }
+
+    return buffer;
+}
+
 pixman_implementation_t *
 _pixman_implementation_create_rvv (pixman_implementation_t *fallback)
 {
