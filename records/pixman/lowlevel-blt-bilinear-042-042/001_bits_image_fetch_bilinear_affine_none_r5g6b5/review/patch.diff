index d510cacb..7068cce6 100644
--- a/pixman/pixman-fast-path.c
+++ b/pixman/pixman-fast-path.c
@@ -2878,6 +2878,16 @@ bits_image_fetch_bilinear_affine (pixman_image_t * image,
     x = v.vector[0];
     y = v.vector[1];
 
+#ifdef USE_RVV
+    if (!mask && width > 32 && format == PIXMAN_r5g6b5 &&
+	repeat_mode == PIXMAN_REPEAT_NONE && _pixman_have_rvv)
