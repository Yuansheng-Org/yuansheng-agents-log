diff --git a/pixman/pixman-rvv.c b/pixman/pixman-rvv.c
index 570799c..590d4dd 100644
--- a/pixman/pixman-rvv.c
+++ b/pixman/pixman-rvv.c
@@ -3092,6 +3092,184 @@ static const pixman_fast_path_t rvv_fast_paths[] = {
     {PIXMAN_OP_NONE},
 };
 
+/* Bilinear-affine NONE 8888 fetch, vectorized (minimal subset).
+ *
+ * Covers only: format a8r8g8b8, repeat=NONE, no mask. Interior pixels (all 4
+ * taps in-bounds) are gathered (vluxei64, clamped) and blended with the SWAR
+ * bilinear_interpolation; out-of-bounds lanes are zeroed; partially-out
+ * border lanes are recomputed by a scalar tail using the per-tap zeroing that
+ * matches bits_image_fetch_bilinear_affine.
+ */
+uint32_t *
+_pixman_rvv_bits_image_fetch_bilinear_affine_none_8888 (
+    pixman_image_t *image, int offset, int line, int width,
+    uint32_t *buffer, const uint32_t *mask)
+{
+    bits_image_t *bits = &image->bits;
+    pixman_fixed_t x, y, ux, uy;
+    pixman_vector_t v;
+    const size_t vlmax = __riscv_vsetvlmax_e32m4 ();
+    const int32_t W = bits->width, H = bits->height, rs = bits->rowstride;
+    uint8_t imask[64];
+    size_t n = (size_t)width;
+    uint32_t *dst = buffer;
+
+    v.vector[0] = pixman_int_to_fixed (offset) + pixman_fixed_1 / 2;
+    v.vector[1] = pixman_int_to_fixed (line) + pixman_fixed_1 / 2;
+    v.vector[2] = pixman_fixed_1;
+    if (!pixman_transform_point_3d (image->common.transform, &v))
+	return buffer;
+    ux = image->common.transform->matrix[0][0];
+    uy = image->common.transform->matrix[1][0];
+    x = v.vector[0];
+    y = v.vector[1];
+
+    while (n >= vlmax)
+    {
+	size_t vl = vlmax;
+	pixman_fixed_t xb = x, yb = y;
+	vuint32m4_t iu = __riscv_vid_v_u32m4 (vl);
+	vint32m4_t iv = __riscv_vreinterpret_v_u32m4_i32m4 (iu);
+	vint32m4_t x1, y1, x1i, y1i, x2i, y2i;
+	vint32m4_t dx, dy;
+	vint32m4_t rsv = __riscv_vmv_v_x_i32m4 (rs, vl);
+	vbool8_t im;
+	vuint32m4_t tl, tr, bl, br;
+	vuint32m4_t dxy, dxiy, dixy, dixiy, lo, hi, out;
+	vuint8m1_t msk;
+
+	x1 = __riscv_vncvt_x_x_w_i32m4 (
+	    __riscv_vwadd_wx_i64m8 (__riscv_vwmul_vx_i64m8 (iv, ux, vl), x - 32768, vl), vl);
+	y1 = __riscv_vncvt_x_x_w_i32m4 (
+	    __riscv_vwadd_wx_i64m8 (__riscv_vwmul_vx_i64m8 (iv, uy, vl), y - 32768, vl), vl);
+
+	dx = __riscv_vand_vx_i32m4 (__riscv_vsra_vx_i32m4 (x1, 9, vl), 0x7f, vl);
+	dy = __riscv_vand_vx_i32m4 (__riscv_vsra_vx_i32m4 (y1, 9, vl), 0x7f, vl);
+	x1i = __riscv_vsra_vx_i32m4 (x1, 16, vl);
+	y1i = __riscv_vsra_vx_i32m4 (y1, 16, vl);
+	x2i = __riscv_vadd_vx_i32m4 (x1i, 1, vl);
+	y2i = __riscv_vadd_vx_i32m4 (y1i, 1, vl);
+
+	im = __riscv_vmand_mm_b8 (
+	    __riscv_vmand_mm_b8 (
+		__riscv_vmsge_vx_i32m4_b8 (x1i, 0, vl),
+		__riscv_vmsle_vx_i32m4_b8 (x2i, W - 1, vl), vl),
+	    __riscv_vmand_mm_b8 (
+		__riscv_vmsge_vx_i32m4_b8 (y1i, 0, vl),
+		__riscv_vmsle_vx_i32m4_b8 (y2i, H - 1, vl), vl), vl);
+
+	/* clamp addresses to avoid faults on out-of-bounds lanes */
+	x1i = __riscv_vmax_vx_i32m4 (x1i, 0, vl);
+	x2i = __riscv_vmin_vx_i32m4 (x2i, W - 1, vl);
+	y1i = __riscv_vmax_vx_i32m4 (y1i, 0, vl);
+	y2i = __riscv_vmin_vx_i32m4 (y2i, H - 1, vl);
+
+#define GATHER_(yy, xx) __riscv_vluxei64_v_u32m4 (bits->bits, \
+	    __riscv_vreinterpret_v_i64m8_u64m8 (__riscv_vadd_vv_i64m8 ( \
+		__riscv_vwmul_vv_i64m8 (yy, rsv, vl), __riscv_vwcvt_x_x_v_i64m8 (xx, vl), vl)), vl)
+	tl = GATHER_ (y1i, x1i);
+	tr = GATHER_ (y1i, x2i);
+	bl = GATHER_ (y2i, x1i);
+	br = GATHER_ (y2i, x2i);
+#undef GATHER_
+
+	{
+	    vuint32m4_t dxu = __riscv_vsrl_vx_u32m4 (__riscv_vreinterpret_v_i32m4_u32m4 (dx), 3, vl);
+	    vuint32m4_t dyu = __riscv_vsrl_vx_u32m4 (__riscv_vreinterpret_v_i32m4_u32m4 (dy), 3, vl);
+	    dxy = __riscv_vmul_vv_u32m4 (dxu, dyu, vl);
+	    dxiy = __riscv_vsub_vv_u32m4 (__riscv_vsll_vx_u32m4 (dxu, 4, vl), dxy, vl);
+	    dixy = __riscv_vsub_vv_u32m4 (__riscv_vsll_vx_u32m4 (dyu, 4, vl), dxy, vl);
+	    dixiy = __riscv_vadd_vv_u32m4 (__riscv_vsub_vv_u32m4 (__riscv_vsub_vv_u32m4 (
+		__riscv_vmv_v_x_u32m4 (256, vl), __riscv_vsll_vx_u32m4 (dyu, 4, vl), vl),
+		__riscv_vsll_vx_u32m4 (dxu, 4, vl), vl), dxy, vl);
+	}
+
+	lo = __riscv_vmul_vv_u32m4 (__riscv_vand_vx_u32m4 (tl, 0xff00ff, vl), dixiy, vl);
+	hi = __riscv_vmul_vv_u32m4 (__riscv_vand_vx_u32m4 (__riscv_vsrl_vx_u32m4 (tl, 8, vl), 0xff00ff, vl), dixiy, vl);
+	lo = __riscv_vadd_vv_u32m4 (lo, __riscv_vmul_vv_u32m4 (__riscv_vand_vx_u32m4 (tr, 0xff00ff, vl), dxiy, vl), vl);
+	hi = __riscv_vadd_vv_u32m4 (hi, __riscv_vmul_vv_u32m4 (__riscv_vand_vx_u32m4 (__riscv_vsrl_vx_u32m4 (tr, 8, vl), 0xff00ff, vl), dxiy, vl), vl);
+	lo = __riscv_vadd_vv_u32m4 (lo, __riscv_vmul_vv_u32m4 (__riscv_vand_vx_u32m4 (bl, 0xff00ff, vl), dixy, vl), vl);
+	hi = __riscv_vadd_vv_u32m4 (hi, __riscv_vmul_vv_u32m4 (__riscv_vand_vx_u32m4 (__riscv_vsrl_vx_u32m4 (bl, 8, vl), 0xff00ff, vl), dixy, vl), vl);
+	lo = __riscv_vadd_vv_u32m4 (lo, __riscv_vmul_vv_u32m4 (__riscv_vand_vx_u32m4 (br, 0xff00ff, vl), dxy, vl), vl);
+	hi = __riscv_vadd_vv_u32m4 (hi, __riscv_vmul_vv_u32m4 (__riscv_vand_vx_u32m4 (__riscv_vsrl_vx_u32m4 (br, 8, vl), 0xff00ff, vl), dxy, vl), vl);
+	out = __riscv_vor_vv_u32m4 (
+	    __riscv_vand_vx_u32m4 (__riscv_vsrl_vx_u32m4 (lo, 8, vl), 0xff00ff, vl),
+	    __riscv_vand_vx_u32m4 (hi, 0xff00ff00, vl), vl);
+	out = __riscv_vmerge_vvm_u32m4 (out, __riscv_vmv_v_x_u32m4 (0, vl), im, vl);
+	__riscv_vse32_v_u32m4 (dst, out, vl);
+
+	/* save interior mask for scalar border recompute */
+	msk = __riscv_vmerge_vvm_u8m1 (
+	    __riscv_vmv_v_x_u8m1 (0, vl), __riscv_vmv_v_x_u8m1 (1, vl), im, vl);
+	__riscv_vse8_v_u8m1 (imask, msk, vl);
+
+	{
+	    size_t i;
+	    for (i = 0; i < vl; i++)
+	    {
+		int xx, yy, xx2, yy2, distx, disty;
+		uint32_t ttl, ttr, tbl, tbr;
+		if (imask[i])
+		    continue;
+		xx = xb + (pixman_fixed_t)((int64_t)i * ux);
+		yy = yb + (pixman_fixed_t)((int64_t)i * uy);
+		xx -= pixman_fixed_1 / 2;
+		yy -= pixman_fixed_1 / 2;
+		distx = pixman_fixed_to_bilinear_weight (xx);
+		disty = pixman_fixed_to_bilinear_weight (yy);
+		xx = pixman_fixed_to_int (xx);
+		yy = pixman_fixed_to_int (yy);
+		xx2 = xx + 1;
+		yy2 = yy + 1;
+		if (xx >= W || xx2 < 0 || yy >= H || yy2 < 0)
+		{
+		    dst[i] = 0;
+		    continue;
+		}
+		ttl = (yy >= 0 && xx >= 0) ? bits->bits[rs * yy + xx] : 0;
+		ttr = (yy >= 0 && xx2 < W)  ? bits->bits[rs * yy + xx2] : 0;
+		tbl = (yy2 < H && xx >= 0)  ? bits->bits[rs * yy2 + xx] : 0;
+		tbr = (yy2 < H && xx2 < W)  ? bits->bits[rs * yy2 + xx2] : 0;
+		dst[i] = bilinear_interpolation (ttl, ttr, tbl, tbr, distx, disty);
+	    }
+	}
+
+	x = (pixman_fixed_t)((int64_t)x + (int64_t)vl * ux);
+	y = (pixman_fixed_t)((int64_t)y + (int64_t)vl * uy);
+	dst += vl;
+	n -= vl;
+    }
+
+    while (n-- > 0)
+    {
+	int x1, y1, x2, y2;
+	int32_t distx, disty;
+	uint32_t tl, tr, bl, br;
+
+	x1 = x - pixman_fixed_1 / 2;
+	y1 = y - pixman_fixed_1 / 2;
+	distx = pixman_fixed_to_bilinear_weight (x1);
+	disty = pixman_fixed_to_bilinear_weight (y1);
+	y1 = pixman_fixed_to_int (y1); y2 = y1 + 1;
+	x1 = pixman_fixed_to_int (x1); x2 = x1 + 1;
+	if (x1 >= W || x2 < 0 || y1 >= H || y2 < 0)
+	    *dst = 0;
+	else
+	{
+	    tl = (y1 >= 0 && x1 >= 0) ? bits->bits[rs * y1 + x1] : 0;
+	    tr = (y1 >= 0 && x2 < W)  ? bits->bits[rs * y1 + x2] : 0;
+	    bl = (y2 < H  && x1 >= 0) ? bits->bits[rs * y2 + x1] : 0;
+	    br = (y2 < H  && x2 < W)  ? bits->bits[rs * y2 + x2] : 0;
+	    *dst = bilinear_interpolation (tl, tr, bl, br, distx, disty);
+	}
+	dst++;
+	x += ux;
+	y += uy;
+    }
+
+    return buffer;
+}
+
 pixman_implementation_t *
 _pixman_implementation_create_rvv (pixman_implementation_t *fallback)
 {
