diff --git a/pixman/pixman-rvv.c b/pixman/pixman-rvv.c
index 570799c..e6938b9 100644
--- a/pixman/pixman-rvv.c
+++ b/pixman/pixman-rvv.c
@@ -3092,6 +3092,74 @@ static const pixman_fast_path_t rvv_fast_paths[] = {
     {PIXMAN_OP_NONE},
 };
 
+/* Bilinear cover vertical pass, vectorized (minimal subset).
+ *
+ * Replicates fast_fetch_bilinear_cover's 64-bit vertical interpolation: read
+ * the two packed line buffers, extract the AR/GB halves, blend with the scalar
+ * dist_y weight, and repack to ARGB. Covers the SIZEOF_LONG>4 path.
+ */
+void
+_pixman_rvv_fetch_bilinear_cover_vertical (const uint64_t *line0,
+					   const uint64_t *line1,
+					   int32_t dist_y, uint32_t *buffer,
+					   size_t n)
+{
+    const size_t vlmax = __riscv_vsetvlmax_e32m4 ();
+    size_t m = n;
+    uint32_t *dst = buffer;
+    const uint64_t *t = line0, *b = line1;
+
+    while (m >= vlmax)
+    {
+	size_t vl = vlmax;
+	vuint64m8_t top = __riscv_vle64_v_u64m8 (t, vl);
+	vuint64m8_t bot = __riscv_vle64_v_u64m8 (b, vl);
+	vuint64m8_t tar = __riscv_vsrl_vx_u64m8 (
+	    __riscv_vand_vx_u64m8 (top, 0xffff0000ffff0000ULL, vl), 16, vl);
+	vuint64m8_t bar = __riscv_vsrl_vx_u64m8 (
+	    __riscv_vand_vx_u64m8 (bot, 0xffff0000ffff0000ULL, vl), 16, vl);
+	vuint64m8_t tgb = __riscv_vand_vx_u64m8 (top, 0x0000ffff0000ffffULL, vl);
+	vuint64m8_t bgb = __riscv_vand_vx_u64m8 (bot, 0x0000ffff0000ffffULL, vl);
+	vuint64m8_t dw = __riscv_vmv_v_x_u64m8 ((uint64_t)dist_y, vl);
+	vuint64m8_t ar = __riscv_vadd_vv_u64m8 (
+	    __riscv_vsll_vx_u64m8 (tar, 8, vl),
+	    __riscv_vmul_vv_u64m8 (dw, __riscv_vsub_vv_u64m8 (bar, tar, vl), vl), vl);
+	vuint64m8_t gb = __riscv_vadd_vv_u64m8 (
+	    __riscv_vsll_vx_u64m8 (tgb, 8, vl),
+	    __riscv_vmul_vv_u64m8 (dw, __riscv_vsub_vv_u64m8 (bgb, tgb, vl), vl), vl);
+
+	vuint64m8_t a = __riscv_vand_vx_u64m8 (__riscv_vsrl_vx_u64m8 (ar, 24, vl), 0xff000000ULL, vl);
+	vuint64m8_t r = __riscv_vand_vx_u64m8 (ar, 0x00ff0000ULL, vl);
+	vuint64m8_t g = __riscv_vand_vx_u64m8 (__riscv_vsrl_vx_u64m8 (gb, 40, vl), 0x0000ff00ULL, vl);
+	vuint64m8_t bb = __riscv_vand_vx_u64m8 (__riscv_vsrl_vx_u64m8 (gb, 16, vl), 0x000000ffULL, vl);
+	vuint64m8_t out64 = __riscv_vor_vv_u64m8 (
+	    __riscv_vor_vv_u64m8 (a, r, vl), __riscv_vor_vv_u64m8 (g, bb, vl), vl);
+	vuint32m4_t out = __riscv_vncvt_x_x_w_u32m4 (out64, vl);
+	__riscv_vse32_v_u32m4 (dst, out, vl);
+
+	t += vl;
+	b += vl;
+	dst += vl;
+	m -= vl;
+    }
+
+    while (m-- > 0)
+    {
+	uint64_t top = *t++;
+	uint64_t bot = *b++;
+	uint64_t tar = (top & 0xffff0000ffff0000ULL) >> 16;
+	uint64_t bar = (bot & 0xffff0000ffff0000ULL) >> 16;
+	uint64_t tgb = (top & 0x0000ffff0000ffffULL);
+	uint64_t bgb = (bot & 0x0000ffff0000ffffULL);
+	uint64_t ar = (tar << 8) + dist_y * (bar - tar);
+	uint64_t gb = (tgb << 8) + dist_y * (bgb - tgb);
+	*dst++ = (uint32_t)(((ar >> 24) & 0xff000000ULL) |
+			    ((ar >> 0) & 0x00ff0000ULL) |
+			    ((gb >> 40) & 0x0000ff00ULL) |
+			    ((gb >> 16) & 0x000000ffULL));
+    }
+}
+
 pixman_implementation_t *
 _pixman_implementation_create_rvv (pixman_implementation_t *fallback)
 {
