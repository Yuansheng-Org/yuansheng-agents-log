diff --git a/pixman/pixman-rvv.c b/pixman/pixman-rvv.c
index 570799c..0953403 100644
--- a/pixman/pixman-rvv.c
+++ b/pixman/pixman-rvv.c
@@ -3092,6 +3092,51 @@ static const pixman_fast_path_t rvv_fast_paths[] = {
     {PIXMAN_OP_NONE},
 };
 
+/* A8 -> ARGB32 source scanline fetch, vectorized.
+ *
+ * The scalar reference (pixman-access.c: fetch_scanline_a8) expands each
+ * source byte alpha into a 32-bit a8r8g8b8 pixel: (alpha << 24) with the RGB
+ * channels zero. Here the same expansion is batched with RVV:
+ *
+ *   vle8.v      load alpha bytes (SEW=8, m1)
+ *   vzext.vf4   zero-extend each byte to a 32-bit lane (SEW=32, m4)
+ *   vsll.vi 24  place alpha in the top byte
+ *   vse32.v     store the packed a8r8g8b8 pixels
+ *
+ * The mask argument is unused, matching the generated accessor contract.
+ */
+void
+_pixman_rvv_fetch_scanline_a8 (bits_image_t *   image,
+                               int              x,
+                               int              y,
+                               int              width,
+                               uint32_t *       buffer,
+                               const uint32_t * mask)
+{
+    const uint8_t *bits;
+    size_t         n;
+    size_t         vl;
+
+    bits = (const uint8_t *)(image->bits + y * image->rowstride) + x;
+    n    = (size_t)width;
+
+    while (n > 0)
+    {
+	vuint8m1_t  src;
+	vuint32m4_t dst;
+
+	vl  = __riscv_vsetvl_e8m1 (n);
+	src = __riscv_vle8_v_u8m1 (bits, vl);
+	dst = __riscv_vzext_vf4_u32m4 (src, vl);
+	dst = __riscv_vsll_vx_u32m4 (dst, 24, vl);
+	__riscv_vse32_v_u32m4 (buffer, dst, vl);
+
+	bits   += vl;
+	buffer += vl;
+	n      -= vl;
+    }
+}
+
 pixman_implementation_t *
 _pixman_implementation_create_rvv (pixman_implementation_t *fallback)
 {
