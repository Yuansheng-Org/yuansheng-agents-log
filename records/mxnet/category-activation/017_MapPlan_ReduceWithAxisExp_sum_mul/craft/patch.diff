+/*!
+ * \brief reduction step for the axis reducer.
+ *  red::sum::Reduce takes a `volatile DType&` accumulator, which forces the
+ *  partial sum to be stored to and reloaded from memory on every reduction
+ *  step.  For the additive reducer a plain register accumulation performs the
+ *  identical `dst += src` sequence (same order, same result) without the
+ *  volatile memory round-trip.  Every other reducer keeps the existing
+ *  Reducer::Reduce contract.
+ */
+template<typename DType>
+MSHADOW_XINLINE void ReduceWithAxisStep(red::sum, DType &acc, DType val) {  // NOLINT(*)
+  acc += val;
+}
+template<typename Reducer, typename DType>
+MSHADOW_XINLINE void ReduceWithAxisStep(Reducer, DType &acc, DType val) {  // NOLINT(*)
+  Reducer::Reduce(acc, val);
+}
